---
// Atmospheric Hero component: JetBrains-inspired Engineering Authority & Zora Palette
---

<header class="hero-container">
  <!-- Location & Availability Badge -->
  <div class="availability-bezel">
    <span class="status-indicator"></span>
    <span class="bezel-label">Pacific Time (PST)</span>
    <span class="bezel-sep">•</span>
    <span class="bezel-label">North America</span>
    <span class="bezel-sep">•</span>
    <span class="bezel-highlight">California On-Site Ready</span>
  </div>

  <!-- Primary Headline (Titanium Solid White - Anti-AI slop) -->
  <h1 class="hero-headline">
    Native iOS & Android.<br />
    One unified Kotlin codebase.
  </h1>

  <!-- Human & Direct Subheadline -->
  <p class="hero-subheadline">
    Staff Mobile Platform Architect & KMP Specialist. Architecting high-performance shared foundations for North American teams—delivering 120 FPS native framerates with zero compromise on platform feel.
  </p>

  <!-- Platform Readiness Strip (JetBrains Inspired Proof of Reality) -->
  <div class="platform-readiness-strip">
    <div class="platform-pill">
      <span class="platform-name">iOS</span>
      <span class="platform-status status-stable">Stable</span>
    </div>
    <div class="platform-pill">
      <span class="platform-name">Android</span>
      <span class="platform-status status-native">Jetpack</span>
    </div>
    <div class="platform-pill">
      <span class="platform-name">Desktop</span>
      <span class="platform-status status-subtle">macOS / Linux / Windows</span>
    </div>
    <div class="platform-pill">
      <span class="platform-name">Web</span>
      <span class="platform-status status-beta">Wasm Beta</span>
    </div>
  </div>

  <!-- CTAs Group -->
  <div class="hero-cta-group">
    <a href="#consulting" class="button btn-zora-spectrum">
      <span>Book Architecture Audit</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
    <a href="#proof-of-work" class="button btn-titanium">
      <span>Explore Proof of Work</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
    </a>
  </div>
</header>

<style>
  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 5rem 1.5rem 3.5rem;
    max-width: 920px;
    margin: 0 auto;
  }

  /* Availability Bezel */
  .availability-bezel {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(180deg, #181b21 0%, #101216 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 4px 14px rgba(0, 0, 0, 0.6);
    padding: 7px 18px;
    border-radius: 9999px;
    margin-bottom: 2.25rem;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--zora-magenta);
    box-shadow: 0 0 10px var(--zora-magenta);
  }

  .bezel-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-metal-secondary);
  }

  .bezel-sep {
    color: rgba(255, 255, 255, 0.15);
    font-size: 0.8rem;
  }

  .bezel-highlight {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--zora-edge);
  }

  /* Solid White Titanium Headline */
  .hero-headline {
    font-size: clamp(2.4rem, 6.2vw, 4.25rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }

  /* Human Subheadline */
  .hero-subheadline {
    font-size: clamp(1.08rem, 2.3vw, 1.25rem);
    color: #b0b8c4;
    line-height: 1.62;
    max-width: 680px;
    margin-bottom: 2.25rem;
    letter-spacing: -0.01em;
  }

  /* Platform Readiness Strip */
  .platform-readiness-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 2.75rem;
    padding: 10px 16px;
    background: rgba(18, 20, 26, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    backdrop-filter: blur(12px);
  }

  .platform-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .platform-name {
    font-weight: 700;
    color: #ffffff;
  }

  .platform-status {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-stable {
    color: #8A4DFF;
    background: rgba(138, 77, 255, 0.15);
    border: 1px solid rgba(138, 77, 255, 0.3);
  }

  .status-native {
    color: #CD00EC;
    background: rgba(205, 0, 236, 0.15);
    border: 1px solid rgba(205, 0, 236, 0.3);
  }

  .status-subtle {
    color: var(--text-metal-secondary);
    background: rgba(255, 255, 255, 0.05);
  }

  .status-beta {
    color: #ED158A;
    background: rgba(237, 21, 138, 0.15);
    border: 1px solid rgba(237, 21, 138, 0.3);
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
    width: 100%;
  }

  .btn-zora-spectrum {
    padding: 0 30px;
    font-size: 1rem;
    font-weight: 700;
  }

  .btn-titanium {
    padding: 0 26px;
  }
</style>
