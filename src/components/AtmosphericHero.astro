---
// Atmospheric Hero component: JetBrains-inspired Engineering Authority & Zora Palette
// Fully migrated to Tailwind CSS v4: Single-column on < 1024px, Split 2-column with 57% expanded carousel on >= 1024px
import ShowcaseCarousel from './ShowcaseCarousel.astro';
---

<header class="relative z-10 w-full mx-auto px-5 py-14 sm:px-7 sm:py-16 md:px-10 md:py-18 lg:px-10 lg:py-20 xl:px-8 xl:py-22 max-w-7xl overflow-hidden">
  <!-- Atmospheric Background Graphic (Zora Cards) -->
  <div class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden flex items-center justify-center" aria-hidden="true">
    <img 
      src="/images/zora-cards.png" 
      alt="" 
      loading="eager" 
      decoding="async" 
      class="w-full h-full object-cover object-center opacity-15 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
    />
  </div>

  <div class="relative z-10 flex flex-col items-center lg:flex-row lg:items-start lg:justify-between gap-9 sm:gap-10 md:gap-12 lg:gap-10 xl:gap-14 w-full">
    <!-- Left Column: Editorial Authority & Action -->
    <div class="w-full lg:flex-1 flex flex-col items-center lg:items-start text-center lg:text-left pt-0 lg:pt-10 xl:pt-12">
      <!-- Zora Brand Logo Icon over the Headline -->
      <div class="mb-3 lg:mb-5 flex items-center">
        <img 
          src="/images/zora-transparent.png" 
          alt="Zora / Jesús Daniel Medina Cruz" 
          width="64" 
          height="64" 
          class="w-13 h-13 sm:w-14 sm:h-14 lg:w-16 lg:h-16 object-contain drop-shadow-[0_4px_16px_rgba(138,77,255,0.45)]"
        />
      </div>

      <!-- Primary Headline (Titanium Solid White - JetBrains style) -->
      <h1 class="text-white font-extrabold tracking-tight text-4xl sm:text-5xl md:text-5xl lg:text-5xl xl:text-6xl leading-[1.08] mb-4 lg:mb-5 drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)]">
        iOS & Android Development
      </h1>

      <!-- Human & Direct Subheadline -->
      <p class="text-[#b0b8c4] text-base sm:text-lg lg:text-lg leading-relaxed max-w-lg sm:max-w-xl lg:max-w-md xl:max-w-lg mb-7 sm:mb-8 lg:mb-9">
        Staff Mobile Platform Architect & KMP Specialist. Shared Kotlin foundations with native performance.
      </p>

      <!-- CTAs Group (Direct & Focused) -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 w-full max-w-xs sm:max-w-none">
        <a href="#consulting" class="button btn-zora-spectrum w-full sm:w-auto justify-center">
          <span>Book Architecture Audit</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#proof-of-work" class="button btn-titanium w-full sm:w-auto justify-center">
          <span>Explore Proof of Work</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Production Showcase Carousel (JetBrains style, ready for Zora) -->
    <!-- On < 1024px: centered with max-w-xl. On >= 1024px (lg): flex-none 57% width without max-width restriction -->
    <div class="w-full max-w-xl lg:max-w-none lg:w-[57%] flex justify-center lg:justify-end">
      <ShowcaseCarousel />
    </div>
  </div>
</header>
