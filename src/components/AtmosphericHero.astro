---
// Atmospheric Hero component: JetBrains-inspired Engineering Authority & Zora Palette
// Pixel-perfect alignment with kotlinlang.org/compose-multiplatform
// Mobile-first responsive layout (< 1024px single-column, >= 1024px split-column 57% showcase)
import ShowcaseCarousel from './ShowcaseCarousel.astro';
---

<header class="relative z-10 w-full mx-auto px-5 py-14 sm:px-7 sm:py-16 md:px-10 md:py-20 lg:px-8 lg:py-20 xl:px-8 xl:py-22 max-w-[1240px] overflow-hidden">
  <!-- Atmospheric Background Graphic (Zora Cards) -->
  <div class="hero-backdrop absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden flex items-center justify-center" aria-hidden="true">
    <img 
      src="/images/zora-cards.png" 
      alt="" 
      loading="eager" 
      decoding="async" 
      class="backdrop-graphic w-full h-full object-cover object-center opacity-14 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
    />
  </div>

  <!-- Responsive Grid: Single column on < 1024px, Split two columns on >= 1024px (JetBrains style) -->
  <div class="relative z-10 flex flex-col items-center lg:flex-row lg:items-start lg:justify-between gap-10 md:gap-12 lg:gap-8 xl:gap-12 w-full text-center lg:text-left">
    <!-- Left Column: Editorial Authority & Action -->
    <div class="w-full lg:flex-1 flex flex-col items-center lg:items-start pt-0 lg:pt-14 xl:pt-18">
      <!-- Zora Brand Logo Icon over the Headline -->
      <div class="mb-3 lg:mb-5 flex items-center">
        <img 
          src="/images/zora-transparent.png" 
          alt="Zora / Jesús Daniel Medina Cruz" 
          width="64" 
          height="64" 
          class="w-[52px] h-[52px] sm:w-[58px] sm:h-[58px] lg:w-[64px] lg:h-[64px] object-contain drop-shadow-[0_4px_16px_rgba(138,77,255,0.45)]"
        />
      </div>

      <!-- Primary Headline (Titanium Solid White - JetBrains ExtraBold Authority) -->
      <h1 class="text-[32px] sm:text-[2.85rem] md:text-[3.25rem] lg:text-[clamp(2.8rem,3.8vw,3.75rem)] font-extrabold leading-[1.08] tracking-[-0.035em] text-white [text-shadow:0_2px_20px_rgba(0,0,0,0.8)] mt-0 mb-4 lg:mb-5">
        <span class="block">iOS & Android</span>
        <span class="block">Development</span>
      </h1>

      <!-- Human & Direct Subheadline -->
      <p class="text-[1.02rem] sm:text-[1.08rem] md:text-[1.15rem] leading-[1.55] md:leading-[1.6] text-[#b0b8c4] font-normal max-w-[500px] sm:max-w-[560px] md:max-w-[620px] lg:max-w-[520px] xl:max-w-[580px] mt-0 mb-7 sm:mb-8 md:mb-9 tracking-[-0.01em]">
        Staff Mobile Platform Architect & KMP Specialist. Shared Kotlin foundations with native performance.
      </p>

      <!-- CTAs Group (Machined Titanium & Zora Master Spectrum Tokens) -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 w-full max-w-[360px] sm:max-w-none">
        <a href="#consulting" class="button btn-zora-spectrum whitespace-nowrap w-full sm:w-auto">
          <span>Book Architecture Audit</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#proof-of-work" class="button btn-titanium whitespace-nowrap w-full sm:w-auto">
          <span>Explore Proof of Work</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Production Showcase Carousel (JetBrains style) -->
    <!-- On < 1024px: centered with max-w-[500px] / md:max-w-[560px] in a single column -->
    <!-- On >= 1024px (lg): flex 57% width without max-width restriction, scaling both width and height -->
    <div class="w-full max-w-[500px] md:max-w-[560px] lg:max-w-none lg:w-[57%] lg:flex-[0_0_57%] flex justify-center lg:justify-end">
      <ShowcaseCarousel />
    </div>
  </div>
</header>
