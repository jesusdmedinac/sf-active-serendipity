---
// Atmospheric Hero component: JetBrains-inspired Engineering Authority & Zora Palette
// Precision responsive layout across sm (640px), md (768px), lg (1024px), xl (1280px)
import ShowcaseCarousel from './ShowcaseCarousel.astro';
---

<header class="hero-container">
  <!-- Atmospheric Background Graphic (Zora Cards) -->
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/zora-cards.png" 
      alt="" 
      loading="eager" 
      decoding="async" 
      class="backdrop-graphic"
    />
  </div>

  <div class="hero-split-grid">
    <!-- Left Column: Editorial Authority & Action -->
    <div class="hero-content">
      <!-- Zora Brand Logo Icon over the Headline -->
      <div class="hero-brand-icon">
        <img 
          src="/images/zora-transparent.png" 
          alt="Zora / Jesús Daniel Medina Cruz" 
          width="64" 
          height="64" 
          class="brand-icon-img"
        />
      </div>

      <!-- Primary Headline (Titanium Solid White - JetBrains style) -->
      <h1 class="hero-headline">
        iOS & Android Development
      </h1>

      <!-- Human & Direct Subheadline -->
      <p class="hero-subheadline">
        Staff Mobile Platform Architect & KMP Specialist. Shared Kotlin foundations with native performance.
      </p>

      <!-- CTAs Group (Direct & Focused) -->
      <div class="hero-cta-group">
        <a href="#consulting" class="button btn-zora-spectrum">
          <span>Book Architecture Audit</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#proof-of-work" class="button btn-titanium">
          <span>Explore Proof of Work</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Production Showcase Carousel (JetBrains style, ready for Zora) -->
    <div class="hero-showcase">
      <ShowcaseCarousel />
    </div>
  </div>
</header>

<style>
  /* ========================================================
     BASE (Mobile-First: < 40rem / < 640px)
     ======================================================== */
  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 3rem;
    overflow: hidden;
  }

  /* Full-bleed Centered Hero Background (Zora Cards) */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .backdrop-graphic {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.14;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
  }

  /* Vertical Flow on Mobile */
  .hero-split-grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 36px;
    align-items: center;
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  /* Brand Icon Over Title */
  .hero-brand-icon {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
  }

  .brand-icon-img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(138, 77, 255, 0.45));
  }

  /* Solid White Titanium Headline */
  .hero-headline {
    font-size: clamp(2.1rem, 7.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin-top: 0;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }

  /* Human Subheadline */
  .hero-subheadline {
    font-size: 1.02rem;
    color: #b0b8c4;
    line-height: 1.55;
    max-width: 500px;
    margin-top: 0;
    margin-bottom: 1.75rem;
    letter-spacing: -0.01em;
  }

  /* CTAs: Stack full-width on mobile */
  .hero-cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 360px;
  }

  .btn-zora-spectrum,
  .btn-titanium {
    width: 100%;
    justify-content: center;
  }

  .hero-showcase {
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 500px;
  }

  /* ========================================================
     BREAKPOINT: sm (width >= 40rem / 640px)
     ======================================================== */
  @media (min-width: 40rem) {
    .hero-container {
      padding: 4.25rem 1.75rem 3.5rem;
    }

    .hero-split-grid {
      gap: 40px;
    }

    .brand-icon-img {
      width: 58px;
      height: 58px;
    }

    .hero-headline {
      font-size: 2.85rem;
    }

    .hero-subheadline {
      font-size: 1.08rem;
      max-width: 560px;
      margin-bottom: 2rem;
    }

    .hero-cta-group {
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
    }

    .btn-zora-spectrum,
    .btn-titanium {
      width: auto;
    }
  }

  /* ========================================================
     BREAKPOINT: md (width >= 48rem / 768px)
     ======================================================== */
  @media (min-width: 48rem) {
    .hero-container {
      padding: 4.75rem 2.5rem 4rem;
    }

    .hero-split-grid {
      gap: 48px;
    }

    .hero-headline {
      font-size: 3.25rem;
    }

    .hero-subheadline {
      font-size: 1.15rem;
      line-height: 1.6;
      max-width: 620px;
      margin-bottom: 2.25rem;
    }

    .hero-showcase {
      max-width: 560px;
    }
  }

  /* ========================================================
     BREAKPOINT: lg (width >= 64rem / 1024px)
     -> Activa el Split Layout como JetBrains en 1000px
     ======================================================== */
  @media (min-width: 64rem) {
    .hero-container {
      padding: 5rem 2.5rem 4.5rem;
      max-width: 1200px;
    }

    .hero-split-grid {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }

    .hero-content {
      flex: 1;
      align-items: flex-start;
      text-align: left;
      padding-top: 24px;
    }

    .hero-brand-icon {
      margin-bottom: 1.25rem;
    }

    .hero-headline {
      font-size: clamp(2.8rem, 3.8vw, 3.75rem);
      margin-bottom: 1.25rem;
    }

    .hero-subheadline {
      margin-bottom: 2.25rem;
      max-width: 520px;
    }

    .hero-cta-group {
      justify-content: flex-start;
    }

    .hero-showcase {
      flex: 0 0 54%;
      max-width: 540px;
      justify-content: flex-end;
    }
  }

  /* ========================================================
     BREAKPOINT: xl (width >= 80rem / 1280px)
     ======================================================== */
  @media (min-width: 80rem) {
    .hero-container {
      padding: 5.5rem 2rem 5rem;
      max-width: 1240px;
    }

    .hero-split-grid {
      gap: 56px;
    }

    .hero-content {
      padding-top: 40px;
    }

    .hero-subheadline {
      max-width: 580px;
    }

    .hero-showcase {
      flex: 0 0 57%;
      max-width: 600px;
    }
  }
</style>
