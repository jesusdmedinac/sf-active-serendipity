---
// Atmospheric Hero component: JetBrains-inspired Engineering Authority & Zora Palette
// Split-layout Architecture with Production Showcase Carousel & Zora Brand Assets
import ShowcaseCarousel from './ShowcaseCarousel.astro';
---

<header class="hero-container">
  <!-- Atmospheric Background Graphic (Zora Cards) -->
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/zora-cards.png" 
      alt="" 
      loading="eager" 
      decoding="async" 
      class="backdrop-graphic"
    />
  </div>

  <div class="hero-split-grid">
    <!-- Left Column: Editorial Authority & Action -->
    <div class="hero-content">
      <!-- Location & Availability Badge -->
      <div class="availability-bezel">
        <span class="status-indicator"></span>
        <span class="bezel-label">Pacific Time (PST)</span>
        <span class="bezel-sep">•</span>
        <span class="bezel-label">North America</span>
        <span class="bezel-sep">•</span>
        <span class="bezel-highlight">California On-Site Ready</span>
      </div>

      <!-- Zora Brand Logo Icon over the Headline -->
      <div class="hero-brand-icon">
        <img 
          src="/images/zora-transparent.png" 
          alt="Zora / Jesús Daniel Medina Cruz" 
          width="64" 
          height="64" 
          class="brand-icon-img"
        />
      </div>

      <!-- Primary Headline (Titanium Solid White - JetBrains style) -->
      <h1 class="hero-headline">
        Native iOS & Android.<br />
        One unified Kotlin codebase.
      </h1>

      <!-- Human & Direct Subheadline -->
      <p class="hero-subheadline">
        Staff Mobile Platform Architect & KMP Specialist. Architecting high-performance shared foundations for North American scale-ups—delivering 120 FPS display-native rendering with zero compromise on platform feel.
      </p>

      <!-- CTAs Group (Direct & Focused) -->
      <div class="hero-cta-group">
        <a href="#consulting" class="button btn-zora-spectrum">
          <span>Book Architecture Audit</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#proof-of-work" class="button btn-titanium">
          <span>Explore Proof of Work</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Production Showcase Carousel (JetBrains style, ready for Zora) -->
    <div class="hero-showcase">
      <ShowcaseCarousel />
    </div>
  </div>
</header>

<style>
  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4.5rem;
    overflow: hidden;
  }

  /* Atmospheric Backdrop Graphic */
  .hero-backdrop {
    position: absolute;
    top: -15%;
    right: -10%;
    width: 900px;
    height: 900px;
    pointer-events: none;
    z-index: -1;
    opacity: 0.18;
    filter: blur(2px);
  }

  .backdrop-graphic {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(-8deg);
  }

  /* Split Layout Grid */
  .hero-split-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-showcase {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Availability Bezel */
  .availability-bezel {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(180deg, #181b21 0%, #101216 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 4px 14px rgba(0, 0, 0, 0.6);
    padding: 7px 18px;
    border-radius: 9999px;
    margin-bottom: 1.75rem;
  }

  .status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--zora-magenta);
    box-shadow: 0 0 10px var(--zora-magenta);
  }

  .bezel-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-metal-secondary);
  }

  .bezel-sep {
    color: rgba(255, 255, 255, 0.15);
    font-size: 0.8rem;
  }

  .bezel-highlight {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--zora-edge);
  }

  /* Brand Icon Over Title */
  .hero-brand-icon {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
  }

  .brand-icon-img {
    width: 58px;
    height: 58px;
    object-fit: contain;
    filter: drop-shadow(0 4px 16px rgba(138, 77, 255, 0.4));
  }

  /* Solid White Titanium Headline */
  .hero-headline {
    font-size: clamp(2.3rem, 4.6vw, 3.85rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }

  /* Human Subheadline */
  .hero-subheadline {
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    color: #b0b8c4;
    line-height: 1.62;
    max-width: 600px;
    margin-bottom: 2.25rem;
    letter-spacing: -0.01em;
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    align-items: center;
    width: 100%;
  }

  .btn-zora-spectrum {
    padding: 0 28px;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .btn-titanium {
    padding: 0 24px;
  }

  /* Responsive Stacking */
  @media (max-width: 1024px) {
    .hero-container {
      padding: 3.5rem 1.25rem 3rem;
    }

    .hero-backdrop {
      width: 600px;
      height: 600px;
      top: -5%;
      right: -20%;
      opacity: 0.12;
    }

    .hero-split-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .hero-subheadline {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta-group {
      justify-content: center;
    }
  }
</style>
