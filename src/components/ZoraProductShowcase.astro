---
// Zora Product Showcase Component: Streamlined Architectural Teaser Plaque
// Focuses on Foundation-Grade KMP Architecture & Funnels to Dedicated Hub (/zora-kmp)
---

<section id="products" class="section-container">
  <div class="machined-chassis">
    <!-- Section Header -->
    <div class="section-header">
      <div class="badge-row">
        <span class="badge-metal badge-scorched-violet">Kotlin Foundation Ecosystem</span>
        <span class="badge-metal badge-anodized-green">Production-Ready Architecture</span>
      </div>
      <h2 class="section-title">Production-Hardened KMP Starter Kits</h2>
      <p class="section-subtitle">
        Accelerate your mobile roadmap with foundation-grade Kotlin Multiplatform templates. Pre-configured with official Kotlin Foundation toolchains, hybrid on-device & cloud Google AI, and generative Server-Driven UI.
      </p>
    </div>

    <!-- 3 Core Architectural Pillars -->
    <div class="pillars-grid">
      <div class="machined-module-card pillar-card">
        <div class="pillar-header">
          <span class="pillar-icon-num">01</span>
          <span class="pillar-tag">DECLARATIVE TOOLCHAIN</span>
        </div>
        <h3 class="pillar-title">Zero Gradle Hell</h3>
        <p class="pillar-desc">
          Integrated with <a href="https://kotlin-toolchain.org" target="_blank" rel="noopener noreferrer" class="link-inline">kotlin-toolchain.org</a>. Pure declarative <code>module.yaml</code> provisioning eliminates hundreds of lines of fragile build scripts, CocoaPods bridge errors, and mismatched plugin versions.
        </p>
        <ul class="pillar-bullets">
          <li>Automated JDK & platform compiler targeting</li>
          <li>Instant project scaffolding via <code>kmp-cli</code></li>
          <li>Touchlab SKIE pre-configured for Swift async/await</li>
        </ul>
      </div>

      <div class="machined-module-card pillar-card">
        <div class="pillar-header">
          <span class="pillar-icon-num">02</span>
          <span class="pillar-tag">HYBRID INTELLIGENCE</span>
        </div>
        <h3 class="pillar-title">On-Device & Cloud AI</h3>
        <p class="pillar-desc">
          Hybrid Gemini Nano on-device processing paired with cloud Google Gemini APIs. Runs edge inference with zero latency and fallback intelligence, protected by strict architectural guardrails.
        </p>
        <ul class="pillar-bullets">
          <li>On-device Gemini Nano with zero network latency</li>
          <li>Strict conversational guardrails (zero topic drift)</li>
          <li>Offline-first SQLDelight local data storage (Android, iOS, Desktop & Web Wasm)</li>
        </ul>
      </div>

      <div class="machined-module-card pillar-card">
        <div class="pillar-header">
          <span class="pillar-icon-num">03</span>
          <span class="pillar-tag">GENERATIVE SDUI</span>
        </div>
        <h3 class="pillar-title">Dynamic Compose UI</h3>
        <p class="pillar-desc">
          Server-Driven UI powered by <code>json-to-compose</code>. Stream dynamically generated native Jetpack Compose and SwiftUI components directly inside conversations and feeds without App Store review cycles.
        </p>
        <ul class="pillar-bullets">
          <li>Real-time JSON to native Compose transpilation</li>
          <li>Sub-second live UI generation within mobile chat</li>
          <li>Adaptive Material 3 dark and light design system</li>
        </ul>
      </div>
    </div>

    <!-- Kotlin Foundation Member Ecosystem Bar -->
    <div class="ecosystem-strip">
      <div class="ecosystem-strip-title">Engineered with Official Kotlin Foundation Members:</div>
      <div class="ecosystem-pills">
        <div class="ecosystem-pill"><span class="pill-dot jetbrains">●</span><strong>JetBrains</strong><span>Compose Core</span></div>
        <div class="ecosystem-pill"><span class="pill-dot google">●</span><strong>Google</strong><span>AndroidX & Gemini</span></div>
        <div class="ecosystem-pill"><span class="pill-dot touchlab">●</span><strong>Touchlab</strong><span>SKIE Interop</span></div>
        <div class="ecosystem-pill"><span class="pill-dot kotzilla">●</span><strong>Kotzilla</strong><span>Koin DI</span></div>
        <div class="ecosystem-pill"><span class="pill-dot gradle">●</span><strong>Gradle</strong><span>Multiplatform Builds</span></div>
      </div>
    </div>

    <!-- Flagship Reference Implementation Callout Plaque -->
    <div class="reference-plaque">
      <div class="reference-badge">
        <span class="led-diode-green"></span>
        <span>FLAGSHIP REFERENCE ARCHITECTURE</span>
      </div>
      <div class="reference-body">
        <div class="reference-info">
          <h4 class="reference-title">Battle-Tested on Zora: Automotive Two-Sided Marketplace</h4>
          <p class="reference-desc">
            These starter kits aren't toy counter apps. They are extracted directly from <strong>Zora</strong>, our high-performance two-sided marketplace connecting vehicle owners to licensed recyclers via real-time reverse auctions, Ktor WebSockets, and SQLDelight persistence.
          </p>
        </div>
        <div class="reference-meta">
          <div class="meta-stat">
            <span class="stat-val">3</span>
            <span class="stat-label">Production Editions</span>
          </div>
          <div class="meta-stat">
            <span class="stat-val">100%</span>
            <span class="stat-label">Shared Logic</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Primary Action Hub -->
    <div class="machined-action-bar">
      <div class="action-info">
        <span class="action-caption">3 Editions Available • Community ($0), Basic ($149), and Enterprise ($299)</span>
        <p class="action-tagline">
          Explore the full side-by-side technical matrix, architecture blueprints, and licensing options:
        </p>
      </div>
      <div class="action-buttons-group">
        <a href="/zora-kmp" class="button btn-anodized-green">
          <span>Explore Starter Kits & Matrix</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://github.com/jesusdmedinac/KMP-CLI" target="_blank" rel="noopener noreferrer" class="button btn-titanium">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>Open KMP-CLI on GitHub</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .machined-chassis {
    position: relative;
    background: linear-gradient(180deg, #13151a 0%, #0c0d10 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.75rem 2.25rem;
    box-shadow: 
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 24px 48px -12px rgba(0, 0, 0, 0.6);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1rem;
  }

  .badge-metal {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 4px;
    font-weight: 600;
  }

  .badge-scorched-violet {
    background: rgba(138, 77, 255, 0.12);
    border: 1px solid rgba(138, 77, 255, 0.35);
    color: #c9abff;
  }

  .badge-anodized-green {
    background: rgba(205, 0, 236, 0.12);
    border: 1px solid rgba(205, 0, 236, 0.35);
    color: #ff9cfd;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-laser-white);
    margin: 0 0 0.75rem 0;
  }

  .section-subtitle {
    font-size: 1.02rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
    max-width: 860px;
    margin: 0;
  }

  /* Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .machined-module-card {
    background: #0f1115;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .machined-module-card:hover {
    border-color: rgba(138, 77, 255, 0.3);
    transform: translateY(-2px);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .pillar-icon-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-engraved);
    background: rgba(255, 255, 255, 0.04);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .pillar-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #b993f7;
    letter-spacing: 0.05em;
  }

  .pillar-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-laser-white);
    margin: 0 0 0.65rem 0;
    letter-spacing: -0.015em;
  }

  .pillar-desc {
    font-size: 0.88rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .pillar-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }

  .pillar-bullets li {
    font-size: 0.8rem;
    color: #bac4d2;
    position: relative;
    padding-left: 14px;
    line-height: 1.45;
  }

  .pillar-bullets li::before {
    content: "›";
    position: absolute;
    left: 0;
    top: -1px;
    color: #A732FD;
    font-weight: bold;
    font-size: 0.95rem;
  }

  .link-inline {
    color: #c9abff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Ecosystem Strip */
  .ecosystem-strip {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .ecosystem-strip-title {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--text-engraved);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ecosystem-pills {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ecosystem-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-metal-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ecosystem-pill strong {
    color: var(--text-laser-white);
    font-weight: 600;
  }

  .ecosystem-pill span:not(.pill-dot) {
    color: var(--text-engraved);
    font-size: 0.72rem;
  }

  .pill-dot {
    font-size: 0.65rem;
  }
  .pill-dot.jetbrains { color: #8A4DFF; }
  .pill-dot.google { color: #4285F4; }
  .pill-dot.touchlab { color: #00E5FF; }
  .pill-dot.kotzilla { color: #FF007F; }
  .pill-dot.gradle { color: #02303A; }

  /* Reference Plaque */
  .reference-plaque {
    background: linear-gradient(135deg, rgba(138, 77, 255, 0.08) 0%, rgba(205, 0, 236, 0.03) 100%);
    border: 1px solid rgba(138, 77, 255, 0.22);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
  }

  .reference-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #c9abff;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .led-diode-green {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00E676;
    box-shadow: 0 0 8px #00E676;
    display: inline-block;
  }

  .reference-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .reference-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-laser-white);
    margin: 0 0 0.5rem 0;
  }

  .reference-desc {
    font-size: 0.88rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin: 0;
    max-width: 680px;
  }

  .reference-desc strong {
    color: var(--text-laser-white);
  }

  .reference-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding-left: 1.5rem;
    flex-shrink: 0;
  }

  .meta-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-laser-white);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-engraved);
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* Machined Action Bar */
  .machined-action-bar {
    background: #0a0b0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .action-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #c9abff;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 4px;
  }

  .action-tagline {
    font-size: 0.92rem;
    color: var(--text-metal-secondary);
    margin: 0;
  }

  .action-buttons-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-anodized-green {
    background: var(--zora-gradient);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 14px rgba(167, 50, 253, 0.35);
  }

  .btn-anodized-green:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(167, 50, 253, 0.5);
  }

  .btn-titanium {
    background: #1a1e24;
    color: var(--text-laser-white);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-titanium:hover {
    background: #232931;
    border-color: rgba(255, 255, 255, 0.22);
  }

  @media (max-width: 900px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .reference-body {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .reference-meta {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1rem;
      width: 100%;
      justify-content: flex-start;
    }
    .machined-action-bar {
      flex-direction: column;
      align-items: flex-start;
    }
    .action-buttons-group {
      width: 100%;
    }
    .action-buttons-group .button {
      flex: 1;
      justify-content: center;
    }
  }
</style>
