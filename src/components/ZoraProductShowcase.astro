---
// Zora Product Showcase Component: Zora KMP Starter Kit & Flagship Initiative
// Premium Machined Industrial Design System with Direct Link to Dedicated Matrix Page (/zora-kmp)
const whatsappBaseUrl = "https://wa.me/14704061747";
const basicWhatsappMsg = encodeURIComponent("Hello Jesús, I want to acquire the Zora KMP Basic Starter Kit license ($149 USD).");
const premiumWhatsappMsg = encodeURIComponent("Hello Jesús, I want to acquire the Zora KMP Premium Enterprise Kit license ($299 USD) with concierge onboarding.");
const generalWhatsappMsg = encodeURIComponent("Hello Jesús, I am interested in acquiring a license for the Zora KMP Starter Kit.");
---

<section id="products" class="section-container">
  <div class="machined-chassis">
    <!-- Section Header -->
    <div class="section-header">
      <div class="badge-row">
        <span class="engraved-label">[ COMMERCIAL DIGITAL PRODUCTS & STARTER KITS ]</span>
        <span class="badge-metal badge-scorched-violet">Kotlin Foundation Ecosystem</span>
        <span class="badge-metal badge-anodized-green">Production-Ready KMP</span>
      </div>
      <h2 class="section-title">Zora KMP Starter Kits</h2>
      <p class="section-subtitle">
        Accelerate your mobile roadmap with production-hardened multiplatform architecture. Pre-configured with the official Kotlin Foundation ecosystem, hybrid on-device & cloud Google AI, and the automated Kotlin Toolchain.
      </p>
    </div>

    <!-- Official Kotlin Foundation Member Tech Stack & Kotlin Toolchain Banner -->
    <div class="ecosystem-showcase-panel">
      <div class="panel-header">
        <span class="engraved-label">[ OFFICIAL ECOSYSTEM INTEGRATION ]</span>
        <h3 class="panel-title">Engineered with Kotlin Foundation Members</h3>
      </div>

      <div class="ecosystem-grid">
        <div class="ecosystem-pill">
          <span class="pill-dot jetbrains">●</span>
          <div class="pill-info">
            <strong>JetBrains</strong>
            <span>Kotlin & Compose Multiplatform Core</span>
          </div>
        </div>
        <div class="ecosystem-pill">
          <span class="pill-dot google">●</span>
          <div class="pill-info">
            <strong>Google</strong>
            <span>AndroidX & Gemini AI Ecosystem</span>
          </div>
        </div>
        <div class="ecosystem-pill">
          <span class="pill-dot touchlab">●</span>
          <div class="pill-info">
            <strong>Touchlab</strong>
            <span>SKIE Seamless Swift/Kotlin Interop</span>
          </div>
        </div>
        <div class="ecosystem-pill">
          <span class="pill-dot kotzilla">●</span>
          <div class="pill-info">
            <strong>Kotzilla</strong>
            <span>Koin Dependency Injection & Telemetry</span>
          </div>
        </div>
        <div class="ecosystem-pill">
          <span class="pill-dot gradle">●</span>
          <div class="pill-info">
            <strong>Gradle</strong>
            <span>Optimized Incremental Multiplatform Builds</span>
          </div>
        </div>
      </div>

      <!-- Kotlin Toolchain Highlight Box -->
      <div class="toolchain-callout">
        <div class="toolchain-meta">
          <span class="engraved-label">AUTOMATED BUILD ENGINE</span>
          <a href="https://kotlin-toolchain.org" target="_blank" rel="noopener noreferrer" class="toolchain-link">
            <span>kotlin-toolchain.org</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>
        </div>
        <p class="toolchain-desc">
          Integrated directly with <strong>Kotlin Toolchain</strong> (<a href="https://kotlin-toolchain.org" target="_blank" rel="noopener noreferrer" class="link-inline">kotlin-toolchain.org</a>) to <strong>eliminate Gradle configuration complexity</strong>. Declarative <code>module.yaml</code> provisioning provisions deterministic JDK environments, compiler targets, and multiplatform toolchains out-of-the-box.
        </p>
      </div>
    </div>

    <!-- 3-Tier Product Pricing Structure -->
    <div class="product-tiers-header">
      <span class="engraved-label">[ PRODUCT STRUCTURE & LICENSING ]</span>
      <h3 class="tiers-headline">Choose Your Starter Kit License</h3>
    </div>

    <div class="product-tiers-grid">
      <!-- Tier 1: Community -->
      <div class="machined-module-card tier-card">
        <div class="tier-badge-row">
          <span class="tier-scope-tag">OPEN CORE</span>
          <span class="tier-num">TIER 1</span>
        </div>
        <h4 class="tier-name">Community</h4>
        <div class="tier-pricing">
          <span class="price-currency">$</span>
          <span class="price-val">0</span>
          <span class="price-unit">USD</span>
        </div>
        <p class="tier-description">
          Functional open-source <strong>Mini-Zora</strong> vehicle search and parts catalog. Shared networking, clean architecture patterns, and standard repository setups.
        </p>
        <ul class="deliverables-list text-secondary">
          <li>Declarative Kotlin Toolchain (<code>module.yaml</code>)</li>
          <li>Compose Multiplatform (Android & iOS shared UI)</li>
          <li>Koin Dependency Injection & Navigation Compose KMP</li>
          <li>Shared Ktor Client 3.x & kotlinx.serialization</li>
          <li>Open-source Apache 2.0 license via KMP-CLI</li>
        </ul>
        <div class="tier-action-wrap">
          <a href="https://github.com/jesusdmedinac/KMP-CLI" target="_blank" rel="noopener noreferrer" class="tier-btn btn-titanium">
            <span>Get Open Core</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Tier 2: Basic Starter Kit -->
      <div class="machined-module-card tier-card">
        <div class="tier-badge-row">
          <span class="tier-scope-tag">SOLO FOUNDERS & APPS</span>
          <span class="tier-num">TIER 2</span>
        </div>
        <h4 class="tier-name">Basic Starter Kit</h4>
        <div class="tier-pricing">
          <span class="price-currency">$</span>
          <span class="price-val">149</span>
          <span class="price-unit">USD</span>
        </div>
        <p class="tier-description">
          Full B2C Client App (<code>:apps:client</code>). Hybrid on-device & cloud Google AI copilot, generative SDUI chat with <code>json-to-compose</code>, and offline-first Room KMP persistence.
        </p>
        <ul class="deliverables-list text-secondary">
          <li>Everything in Community + complete B2C Client App</li>
          <li>On-Device AI (Gemini Nano) + Cloud Gemini API integration</li>
          <li>Generative chat UI via <code>json-to-compose</code> SDUI</li>
          <li>Strict domain guardrails (zero off-topic drift)</li>
          <li>Room KMP "My Garage" offline-first vehicle database</li>
          <li>Zora Material 3 UI Kit with Dark/Light mode & Onboarding</li>
        </ul>
        <div class="tier-action-wrap">
          <a href={`${whatsappBaseUrl}?text=${basicWhatsappMsg}`} target="_blank" rel="noopener noreferrer" class="tier-btn btn-titanium">
            <span>Get Basic License</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Tier 3: Premium Enterprise Kit (Featured) -->
      <div class="machined-module-card is-featured tier-card">
        <div class="tier-badge-row">
          <span class="tier-scope-tag badge-anodized">SCALE-UPS & AGENCIES</span>
          <span class="tier-num highlight">TIER 3</span>
        </div>
        <h4 class="tier-name">Premium Enterprise Kit</h4>
        <div class="tier-pricing">
          <span class="price-currency">$</span>
          <span class="price-val">299</span>
          <span class="price-unit">USD</span>
        </div>
        <p class="tier-description">
          Full Two-Sided Reverse-Auction Marketplace. Double Agent system, Merchant Demand Radar, Ktor WebSockets server, zero-PII privacy, Native Auth, RevenueCat, and CI/CD.
        </p>
        <ul class="deliverables-list text-secondary">
          <li>Everything in Basic + Salvage Yard Radar Dashboard (<code>:apps:merchant</code>)</li>
          <li>The Double Agent coordinator with dual generative SDUI</li>
          <li>Zero-PII privacy enclave driving qualified yard visits</li>
          <li>Central Ktor Server (<code>:services:server</code>) with live WebSockets</li>
          <li>Cross-platform Native Google Sign-In & Apple ID Auth</li>
          <li>RevenueCat In-App Purchases & Touchlab SKIE Swift bridge</li>
          <li>GitHub Actions CI/CD to Google Play (AAB) & TestFlight (IPA)</li>
        </ul>
        <div class="tier-action-wrap">
          <a href={`${whatsappBaseUrl}?text=${premiumWhatsappMsg}`} target="_blank" rel="noopener noreferrer" class="tier-btn btn-anodized-green">
            <span>Get Premium License</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Action Bar: Direct Link to Dedicated /zora-kmp Hub alongside WhatsApp Concierge -->
    <div class="machined-action-bar products-action-bar">
      <div class="action-info">
        <span class="engraved-label">[ COMPREHENSIVE ARCHITECTURE & CAPABILITIES MATRIX ]</span>
        <p class="action-tagline">
          Review the full side-by-side feature matrix, local AI benchmarks, and 2-seat hardware fingerprinting model:
        </p>
      </div>
      <div class="action-buttons-group">
        <a href="/zora-kmp" class="button btn-anodized-green">
          <span>Explore Architecture Matrix</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href={`${whatsappBaseUrl}?text=${generalWhatsappMsg}`} target="_blank" rel="noopener noreferrer" class="button btn-titanium">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.549 1.742.883 2.796.883 3.183 0 5.77-2.587 5.77-5.766.001-3.182-2.585-5.769-5.77-5.769zm10.154 5.767c0 5.614-4.57 10.183-10.185 10.183-1.782 0-3.453-.464-4.912-1.272l-5.688 1.492 1.517-5.541c-.896-1.503-1.402-3.256-1.402-5.132 0-5.614 4.568-10.184 10.185-10.184 5.615 0 10.185 4.57 10.185 10.184z"/></svg>
          <span>WhatsApp Concierge</span>
        </a>
      </div>
    </div>

    <!-- Flagship Engineering Initiative: Zora Used Auto Parts Marketplace -->
    <div class="flagship-block">
      <div class="flagship-header">
        <div class="badge-row">
          <span class="engraved-label">[ FLAGSHIP ENGINEERING INITIATIVE ]</span>
          <span class="badge-metal badge-scorched-violet">AI Reverse Auction</span>
          <span class="badge-metal badge-anodized-green">
            <span class="led-diode-green"></span> Active Development • Private Beta
          </span>
        </div>
        <h3 class="flagship-title">Zora: Global AI-Powered Auto Parts Marketplace</h3>
        <p class="flagship-subtitle">
          Disrupting the multi-billion dollar fragmented auto recyclers industry with an AI-driven reverse auction engine that connects vehicle owners directly to licensed salvage yards.
        </p>
      </div>

      <div class="flagship-chassis-grid">
        <!-- Feature 1: Reverse Auction Engine -->
        <div class="machined-module-card flagship-card">
          <div class="flagship-card-header">
            <span class="card-icon-tag">01</span>
            <span class="engraved-label">REAL-TIME BIDDING ENGINE</span>
          </div>
          <h4 class="flagship-feature-title">Real-Time Reverse Auction</h4>
          <p class="flagship-feature-desc">
            Vehicle owners post part requests with VIN verification. Licensed salvage yards submit competing bids in real time, compressing search times from days to seconds.
          </p>
          <ul class="deliverables-list text-secondary">
            <li>Sub-second bid broadcast via WebSockets & KMP reactive state</li>
            <li>Automated VIN decoding and OEM interchange part cross-referencing</li>
            <li>Zero-PII privacy protection connecting drivers to local yard inventory</li>
          </ul>
        </div>

        <!-- Feature 2: Multimodal AI Visual Part Inspection -->
        <div class="machined-module-card is-featured flagship-card">
          <div class="flagship-card-header">
            <span class="card-icon-tag tag-green">02</span>
            <span class="engraved-label">MULTIMODAL AI & SDUI ENGINE</span>
          </div>
          <h4 class="flagship-feature-title">AI Diagnostics & Generative SDUI</h4>
          <p class="flagship-feature-desc">
            On-device and cloud Google Gemini pipelines inspect driver symptoms, rendering dynamic part inspection cards in-chat via <code>json-to-compose</code>.
          </p>
          <ul class="deliverables-list text-secondary">
            <li>Gemini Nano on-device parsing with zero network latency</li>
            <li>Dynamic Server-Driven UI component transpilation in Compose</li>
            <li>Predictive demand telemetry empowering salvage yards at auto auctions</li>
          </ul>
        </div>
      </div>

      <!-- Private Beta Telemetry & Invitation Strip -->
      <div class="flagship-telemetry-strip">
        <div class="telemetry-info">
          <div class="telemetry-item">
            <span class="telemetry-label">STATUS</span>
            <span class="telemetry-val"><span class="led-diode-green"></span> Active Development • Private Beta</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">CORE PLATFORM</span>
            <span class="telemetry-val">100% Shared Kotlin Multiplatform</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">PARTNER NETWORK</span>
            <span class="telemetry-val">Tijuana – Southern California Corridor</span>
          </div>
        </div>
        <div class="telemetry-action">
          <a href="/zora-kmp" class="button btn-titanium btn-compact">
            <span>Learn More About Zora Platform</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .action-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .action-tagline {
    font-size: 0.92rem;
    color: var(--text-laser-white);
  }

  .products-action-bar {
    margin-top: 2rem;
  }

  .action-buttons-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tier-action-wrap {
    margin-top: 1.25rem;
  }

  .tier-btn {
    width: 100%;
    min-height: 42px;
    font-size: 0.88rem;
    gap: 6px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .ecosystem-showcase-panel {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 1.75rem;
    margin-bottom: 3rem;
  }

  .panel-header {
    margin-bottom: 1.25rem;
  }

  .panel-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .ecosystem-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 10px 14px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .ecosystem-pill:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .pill-dot {
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .pill-dot.jetbrains { color: #f97316; }
  .pill-dot.google    { color: #38bdf8; }
  .pill-dot.touchlab  { color: #a855f7; }
  .pill-dot.kotzilla  { color: #22c55e; }
  .pill-dot.gradle    { color: #06b6d4; }

  .pill-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pill-info strong {
    font-size: 0.88rem;
    color: var(--text-laser-white);
  }

  .pill-info span {
    font-size: 0.72rem;
    color: var(--text-metal-secondary);
    line-height: 1.3;
  }

  .toolchain-callout {
    background: rgba(138, 77, 255, 0.12);
    border: 1px solid rgba(138, 77, 255, 0.35);
    border-radius: 12px;
    padding: 1.15rem 1.4rem;
  }

  .toolchain-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 8px;
  }

  .toolchain-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #d1b8ff;
    transition: opacity 0.15s ease;
  }

  .toolchain-link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .toolchain-desc {
    font-size: 0.88rem;
    color: var(--text-laser-white);
    line-height: 1.55;
  }

  .link-inline {
    color: #d1b8ff;
    text-decoration: underline;
    font-family: var(--font-mono);
  }

  .product-tiers-header {
    margin-bottom: 1.5rem;
  }

  .tiers-headline {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  .product-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .tier-card {
    min-height: 100%;
  }

  .tier-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .tier-scope-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-engraved);
    letter-spacing: 0.06em;
  }

  .tier-scope-tag.badge-anodized {
    color: #ff9dcb;
  }

  .tier-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-metal-secondary);
  }

  .tier-num.highlight {
    color: #ff9dcb;
  }

  .tier-name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .tier-pricing {
    font-family: var(--font-mono);
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin-bottom: 0.85rem;
    color: #ffffff;
  }

  .price-currency {
    font-size: 1.2rem;
    font-weight: 700;
    color: #d1b8ff;
  }

  .price-val {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .price-unit {
    font-size: 0.85rem;
    color: var(--text-metal-secondary);
    font-weight: 600;
    margin-left: 2px;
  }

  .tier-description {
    font-size: 0.86rem;
    color: var(--text-metal-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 900px) {
    .product-tiers-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Flagship Engineering Initiative Styles */
  .flagship-block {
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .flagship-header {
    margin-bottom: 2rem;
  }

  .flagship-title {
    font-size: 1.45rem;
    color: #ffffff;
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  .flagship-subtitle {
    font-size: 0.95rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    max-width: 760px;
    margin-top: 0.4rem;
  }

  .flagship-chassis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .flagship-card {
    padding: 1.75rem 1.5rem;
  }

  .flagship-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.85rem;
  }

  .card-icon-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-engraved);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 6px;
    padding: 2px 7px;
  }

  .card-icon-tag.tag-green {
    color: #ff9dcb;
    background: rgba(237, 21, 138, 0.2);
    border-color: rgba(237, 21, 138, 0.35);
  }

  .flagship-feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .flagship-feature-desc {
    font-size: 0.88rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  /* Telemetry Strip */
  .flagship-telemetry-strip {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 1.25rem 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .telemetry-info {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .telemetry-item {
