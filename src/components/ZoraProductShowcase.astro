---
// Zora Product Showcase Component: Streamlined Flagship Hub Teaser
// Directs visitors to the dedicated architecture & comparison specification at /zora-kmp
const whatsappBaseUrl = "https://wa.me/14704061747";
const whatsappMsg = encodeURIComponent("Hello Jesús, I would like to learn more about the Zora KMP Kits licenses.");
---

<section id="products" class="section-container">
  <div class="machined-chassis">
    <!-- Header -->
    <div class="section-header">
      <div class="badge-row">
        <span class="engraved-label">[ COMMERCIAL DIGITAL PRODUCTS & STARTER KITS ]</span>
        <span class="badge-metal badge-violet">Kotlin Foundation Ecosystem</span>
        <span class="badge-metal badge-titanium">Production-Ready KMP</span>
      </div>
      <h2 class="section-title">Zora KMP Starter Kits</h2>
      <p class="section-subtitle">
        Production-hardened multiplatform architecture eliminating 80+ hours of setup debt. From an open-source Mini-Zora to an AI-powered driver copilot and a complete two-sided reverse-auction salvage marketplace.
      </p>
    </div>

    <!-- Official Kotlin Foundation Member Tech Stack Banner -->
    <div class="ecosystem-banner">
      <div class="ecosystem-label">
        <span class="engraved-label">OFFICIAL ECOSYSTEM STACK:</span>
      </div>
      <div class="ecosystem-tags">
        <span class="tag-item"><strong>JetBrains</strong> Compose Multiplatform</span>
        <span class="tag-item"><strong>Google</strong> AndroidX & Gemini AI</span>
        <span class="tag-item"><strong>Touchlab</strong> SKIE Swift Bridge</span>
        <span class="tag-item"><strong>Kotzilla</strong> Koin DI</span>
        <span class="tag-item"><strong>Gradle</strong> Kotlin Toolchain</span>
      </div>
    </div>

    <!-- 3-Tier Simplified Cards Preview -->
    <div class="tiers-preview-grid">
      <!-- Tier 1 -->
      <div class="preview-card">
        <div class="card-tier-tag">TIER 1 &bull; OPEN CORE</div>
        <h3 class="card-heading">Community Edition</h3>
        <div class="card-price">$0 <span>USD</span></div>
        <p class="card-body">
          A functional open-source <strong>Mini-Zora</strong> automotive parts catalog. Kotlin Toolchain (<code>module.yaml</code>), Compose Multiplatform, Koin, Navigation KMP, and Ktor Client.
        </p>
        <span class="card-badge">Open Source on GitHub</span>
      </div>

      <!-- Tier 2 -->
      <div class="preview-card featured-preview">
        <div class="card-tier-tag tag-violet">TIER 2 &bull; INDIE ACCELERATOR</div>
        <h3 class="card-heading">Basic Starter Kit</h3>
        <div class="card-price">$149 <span>USD</span></div>
        <p class="card-body">
          Full B2C Client App with <strong>hybrid on-device & cloud Google AI</strong>, generative chat UI powered by <code>json-to-compose</code>, domain guardrails, and Room KMP "My Garage" persistence.
        </p>
        <span class="card-badge badge-accent">AI Copilot + SDUI</span>
      </div>

      <!-- Tier 3 -->
      <div class="preview-card enterprise-preview">
        <div class="card-tier-tag tag-pink">TIER 3 &bull; MARKETPLACE IN A BOX</div>
        <h3 class="card-heading">Premium Enterprise</h3>
        <div class="card-price">$299 <span>USD</span></div>
        <p class="card-body">
          Two-sided reverse-auction marketplace: Driver App, Salvage Yard Demand Radar, Ktor WebSockets server, zero-PII privacy enclave, Native Auth, RevenueCat, and GitHub Actions CI/CD.
        </p>
        <span class="card-badge badge-enterprise">Double Agent + Server</span>
      </div>
    </div>

    <!-- Navigation Action Plaque -->
    <div class="action-plaque">
      <div class="plaque-info">
        <span class="engraved-label">[ COMPREHENSIVE ARCHITECTURE & LICENSING SPECIFICATION ]</span>
        <h4 class="plaque-headline">Explore the Complete Technical Matrix & Capabilities</h4>
        <p class="plaque-sub">
          Review the side-by-side feature matrix, on-device AI integration details, 2-seat hardware fingerprinting model, and concierge acquisition terms.
        </p>
      </div>
      <div class="plaque-buttons">
        <a href="/zora-kmp" class="btn-primary-action">
          <span>Explore Zora Kits & Matrix</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href={`${whatsappBaseUrl}?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer" class="btn-concierge">
          WhatsApp Concierge →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-container {
    padding: 3rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .machined-chassis {
    background: var(--metal-void);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 12px;
    padding: 3rem 2.25rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  /* Header */
  .section-header {
    margin-bottom: 2.5rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .engraved-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-engraved);
  }

  .badge-metal {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: var(--metal-steel-mid);
    border: 1px solid var(--chamfer-subtle);
    color: var(--text-laser-white);
  }

  .badge-violet {
    border-color: rgba(138, 77, 255, 0.4);
    color: #d1b8ff;
  }

  .badge-titanium {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-laser-white);
    margin: 0.25rem 0 0.85rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-metal-secondary);
    line-height: 1.6;
    max-width: 820px;
    margin: 0;
  }

  /* Ecosystem Banner */
  .ecosystem-banner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--metal-gunmetal);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 6px;
    margin-bottom: 2.5rem;
  }

  .ecosystem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-item {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-metal-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .tag-item strong {
    color: var(--text-laser-white);
  }

  /* Tiers Grid */
  .tiers-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .preview-card {
    background: var(--metal-gunmetal);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .featured-preview {
    border-color: rgba(138, 77, 255, 0.45);
    background: linear-gradient(180deg, rgba(22, 24, 29, 0.95) 0%, rgba(15, 17, 21, 0.98) 100%);
  }

  .enterprise-preview {
    border-color: rgba(237, 21, 138, 0.45);
    background: linear-gradient(180deg, rgba(29, 33, 39, 0.95) 0%, rgba(15, 17, 21, 0.98) 100%);
  }

  .card-tier-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-engraved);
    margin-bottom: 0.5rem;
  }

  .tag-violet {
    color: #d1b8ff;
  }

  .tag-pink {
    color: #ff9dcb;
  }

  .card-heading {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-laser-white);
    margin: 0 0 0.5rem;
  }

  .card-price {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-laser-white);
    margin-bottom: 0.85rem;
  }

  .card-price span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-engraved);
  }

  .card-body {
    font-size: 0.92rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .card-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-metal-secondary);
  }

  .badge-accent {
    background: rgba(138, 77, 255, 0.2);
    color: #d1b8ff;
  }

  .badge-enterprise {
    background: rgba(237, 21, 138, 0.2);
    color: #ff9dcb;
  }

  /* Action Plaque */
  .action-plaque {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.75rem;
    padding: 2rem;
    background: var(--metal-steel-mid);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 8px;
  }

  .plaque-info {
    max-width: 640px;
  }

  .plaque-headline {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-laser-white);
    margin: 0.4rem 0 0.5rem;
  }

  .plaque-sub {
    font-size: 0.92rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .plaque-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--zora-gradient);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(167, 50, 253, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(167, 50, 253, 0.4);
  }

  .btn-concierge {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-laser-white);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .btn-concierge:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15em 0.35em;
    border-radius: 3px;
    color: #d1b8ff;
  }
</style>
