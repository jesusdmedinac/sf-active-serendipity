---
// Consulting & Advisory Card Component: 3-Tier Productized Services Plaque
---

<section id="consulting" class="section-container">
  <div class="consulting-card-machined">
    <div class="card-glow"></div>
    
    <div class="card-content">
      <div class="badge-row">
        <span class="engraved-label">[ PRODUCTIZED ADVISORY & CONSULTING ]</span>
        <span class="badge-metal badge-scorched-violet">Seed to Series B</span>
        <span class="badge-metal badge-anodized-green">Pacific Time (PST)</span>
      </div>

      <h2 class="card-title">Specialized Mobile Architecture Services</h2>
      
      <p class="card-pitch">
        High-leverage architectural leadership for engineering leaders navigating mobile burn rate, hybrid tech debt, or scaling to unified Kotlin Multiplatform codebases.
      </p>

      <!-- 3-Tier Productized Services Grid -->
      <div class="tiers-grid">
        <!-- Tier 1: Architecture & Performance Audit -->
        <div class="tier-card tier-card-machined">
          <div class="tier-badge-row">
            <span class="tier-scope-tag">5-DAY DIAGNOSTIC</span>
            <span class="tier-num">TIER 1</span>
          </div>
          <h3 class="tier-title">Architecture & Performance Audit</h3>
          <div class="tier-pricing">
            <span class="price-currency">$</span>
            <span class="price-val">3,000</span>
            <span class="price-unit">USD</span>
          </div>
          <p class="tier-description">
            Deep forensic diagnosis of memory leaks, jank, ANRs, test suite coverage, and modularization health check.
          </p>
          <ul class="tier-deliverables">
            <li><span>✓</span> Trace profiling with Perfetto & Instruments</li>
            <li><span>✓</span> Clean Architecture & dependency health review</li>
            <li><span>✓</span> TDD test harness & CI/CD bottleneck audit</li>
            <li><span>✓</span> Executive remediation roadmap & KMP viability report</li>
          </ul>
        </div>

        <!-- Tier 2: KMP Pilot Sprint (Featured) -->
        <div class="tier-card tier-card-machined tier-featured">
          <div class="tier-badge-row">
            <span class="tier-scope-tag badge-anodized">2-WEEK ACCELERATOR</span>
            <span class="tier-num highlight">TIER 2</span>
          </div>
          <h3 class="tier-title">KMP Pilot Sprint</h3>
          <div class="tier-pricing">
            <span class="price-currency">$</span>
            <span class="price-val">3,500</span>
            <span class="price-unit">USD</span>
          </div>
          <p class="tier-description">
            Production-ready shared Kotlin core sprint connecting business logic directly to native SwiftUI and Jetpack Compose.
          </p>
          <ul class="tier-deliverables">
            <li><span>✓</span> Shared networking, cache & domain architecture</li>
            <li><span>✓</span> Clean MVI state flow with zero native bridge penalty</li>
            <li><span>✓</span> Automated CI/CD builds & Kotlin Toolchain setup</li>
            <li><span>✓</span> Hands-on team enablement & developer runbooks</li>
          </ul>
        </div>

        <!-- Tier 3: Fractional Architect -->
        <div class="tier-card tier-card-machined">
          <div class="tier-badge-row">
            <span class="tier-scope-tag">STAFF EMBEDDED</span>
            <span class="tier-num">TIER 3</span>
          </div>
          <h3 class="tier-title">Fractional Architect</h3>
          <div class="tier-pricing">
            <span class="price-currency">$</span>
            <span class="price-val">65–85</span>
            <span class="price-unit">/h USD</span>
          </div>
          <p class="tier-description">
            Embedded staff platform advisory (20–30 hrs/week) aligning executive product vision with mobile engineering velocity.
          </p>
          <ul class="tier-deliverables">
            <li><span>✓</span> 20–30 hours/week dedicated architectural leadership</li>
            <li><span>✓</span> Pacific Time alignment with California cross-border presence</li>
            <li><span>✓</span> Code review standards, TDD culture & staff mentorship</li>
            <li><span>✓</span> Direct technical liaison between leadership and sprint teams</li>
          </ul>
        </div>
      </div>

      <!-- Action Panel: Direct Calendar Integration alongside Direct Contact -->
      <div class="action-panel-machined">
        <div class="action-info">
          <span class="engraved-label">[ DIRECT CONSULTATION BOOKING ]</span>
          <p class="action-tagline">Select a 30-minute diagnostic session directly on the calendar or initiate instant contact:</p>
        </div>
        <div class="action-buttons-group">
          <a href="https://cal.com/jesusdmedinac/mobile-architecture-audit" target="_blank" rel="noopener noreferrer" class="button btn-anodized-green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Book via Calendar</span>
          </a>
          <a href="https://wa.me/14704061747?text=Hi%20Jesus%2C%20I%20am%20interested%20in%20your%20mobile%20architecture%20consulting%20services." target="_blank" rel="noopener noreferrer" class="button btn-titanium">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.549 1.742.883 2.796.883 3.183 0 5.77-2.587 5.77-5.766.001-3.182-2.585-5.769-5.77-5.769zm10.154 5.767c0 5.614-4.57 10.183-10.185 10.183-1.782 0-3.453-.464-4.912-1.272l-5.688 1.492 1.517-5.541c-.896-1.503-1.402-3.256-1.402-5.132 0-5.614 4.568-10.184 10.185-10.184 5.615 0 10.185 4.57 10.185 10.184z"/></svg>
            <span>Direct WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-container {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem;
  }

  .consulting-card-machined {
    position: relative;
    background: linear-gradient(145deg, #181b21 0%, #0e1014 100%);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 20px 50px -10px rgba(0, 0, 0, 0.85);
  }

  .card-glow {
    position: absolute;
    top: -25%;
    left: 20%;
    width: 450px;
    height: 350px;
    background: radial-gradient(circle, rgba(72, 165, 116, 0.16) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
  }

  .card-content {
    position: relative;
    z-index: 1;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 1rem;
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.03em;
  }

  .card-pitch {
    color: var(--text-metal-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  /* 3-Tier Grid */
  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .tier-card-machined {
    position: relative;
    background: linear-gradient(160deg, #16191f 0%, #0f1115 100%);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 18px;
    padding: 1.75rem 1.4rem;
    display: flex;
    flex-direction: column;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 8px 24px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tier-card-machined:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .tier-featured {
    background: linear-gradient(160deg, #18231d 0%, #0e1511 100%);
    border-color: rgba(72, 165, 116, 0.4);
    border-top: 1px solid var(--anodized-green-edge);
    box-shadow: 
      inset 0 1px 0 rgba(118, 227, 171, 0.2),
      0 12px 32px -6px rgba(37, 87, 62, 0.35);
  }

  .tier-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .tier-scope-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-engraved);
    letter-spacing: 0.06em;
  }

  .tier-scope-tag.badge-anodized {
    color: var(--anodized-green-edge);
  }

  .tier-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-metal-secondary);
  }

  .tier-num.highlight {
    color: var(--anodized-green-edge);
  }

  .tier-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .tier-pricing {
    font-family: var(--font-mono);
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin-bottom: 0.85rem;
    color: #ffffff;
  }

  .price-currency {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--anodized-green-edge);
  }

  .price-val {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .price-unit {
    font-size: 0.85rem;
    color: var(--text-metal-secondary);
    font-weight: 600;
    margin-left: 2px;
  }

  .tier-description {
    font-size: 0.86rem;
    color: var(--text-metal-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .tier-deliverables {
    list-style: none;
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .tier-deliverables li {
    font-size: 0.82rem;
    color: var(--text-laser-white);
    line-height: 1.45;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .tier-deliverables li span {
    color: var(--anodized-green-edge);
    font-weight: bold;
    line-height: 1;
    margin-top: 1px;
    flex-shrink: 0;
  }

  /* Action Panel */
  .action-panel-machined {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.4rem 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
  }

  .action-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .action-tagline {
    font-size: 0.92rem;
    color: var(--text-laser-white);
  }

  .action-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-anodized-green {
    padding: 0 24px;
    font-size: 0.95rem;
  }

  .btn-titanium {
    padding: 0 22px;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .tiers-grid {
      grid-template-columns: 1fr;
    }

    .action-panel-machined {
      flex-direction: column;
      align-items: flex-start;
    }

    .action-buttons-group {
      width: 100%;
    }

    .action-buttons-group .button {
      flex: 1;
      justify-content: center;
    }
  }
</style>
