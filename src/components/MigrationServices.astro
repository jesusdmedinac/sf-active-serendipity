---
// Migration Services Component: Cross-Platform Modernization to Native & KMP
---

<section id="modernization" class="section-container">
  <div class="machined-chassis">
    <div class="section-header">
      <div class="badge-row">
        <span class="badge-metal badge-scorched-violet">React Native • Flutter • Hybrid</span>
        <span class="badge-metal badge-anodized-green">Native & KMP Targets</span>
      </div>
      <h2 class="section-title">Cross-Platform to Native & Kotlin Multiplatform</h2>
      <p class="section-subtitle">
        Break free from JavaScript bridge latency, brittle plugins, and dual maintenance overhead with structured, brownfield migration paths.
      </p>
    </div>

    <!-- AI-Accelerated Migration Workflow -->
    <div class="workflow-block">
      <div class="workflow-header">
        <h3 class="workflow-title">High-Velocity Transpilation + Staff Architectural Hardening</h3>
        <p class="workflow-subtitle">
          Combining cutting-edge AI tooling with senior human architectural craft to deliver secure, production-grade native migrations in weeks rather than quarters.
        </p>
      </div>

      <div class="workflow-stages-grid">
        <!-- Stage 1: AI-Assisted Transpilation -->
        <div class="machined-module-card stage-card">
          <div class="stage-tag-row">
            <span class="stage-badge">STAGE 01</span>
            <span class="badge-metal badge-titanium">AST Mapping</span>
          </div>
          <h4 class="stage-title">AI-Assisted Transpilation</h4>
          <div class="stage-focus-box">
            <span class="focus-label">FOCUS:</span>
            <span class="focus-value">Codebase transformation & AST mapping</span>
          </div>
          <p class="stage-deliverables-text">
            <strong>Key Deliverables:</strong> Rapid extraction of models, business logic, and UI components from legacy cross-platform code.
          </p>
          <ul class="deliverables-list text-secondary">
            <li>Automated AST parsing of React Native / Flutter components into Kotlin/Compose models</li>
            <li>High-throughput extraction of TypeScript/Dart business logic without manual boilerplate</li>
            <li>Algorithmic detection of deprecated plugins and native iOS/Android bridge dependencies</li>
          </ul>
        </div>

        <!-- Stage 2: Staff Architectural Hardening -->
        <div class="machined-module-card is-featured stage-card">
          <div class="stage-tag-row">
            <span class="stage-badge badge-green">STAGE 02</span>
            <span class="badge-metal badge-anodized-green">Staff Engineering</span>
          </div>
          <h4 class="stage-title">Staff Architectural Hardening</h4>
          <div class="stage-focus-box focus-box-green">
            <span class="focus-label">FOCUS:</span>
            <span class="focus-value">Human-led architectural engineering</span>
          </div>
          <p class="stage-deliverables-text">
            <strong>Key Deliverables:</strong> Clean Architecture, MVI state flow, zero-bridge native performance, and comprehensive TDD test suites.
          </p>
          <ul class="deliverables-list text-secondary">
            <li>Refactoring shared modules into clean Domain, Data, and Presentation boundaries</li>
            <li>Replacing brittle bridges with direct native compilation and memory safety</li>
            <li>Comprehensive unit and UI test automation ensuring zero functional regressions</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Action Panel: Direct Calendar Integration alongside Direct Contact -->
    <div class="machined-action-bar">
      <div class="action-info">
        <p class="action-tagline">Select a 30-minute diagnostic session directly on the calendar or initiate instant contact:</p>
      </div>
      <div class="action-buttons-group">
        <a href="https://calendar.app.google/u8GcQvp8guvszcKr7" target="_blank" rel="noopener noreferrer" class="button btn-anodized-green">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Book via Calendar</span>
        </a>
        <a href="https://wa.me/14704061747?text=Hi%20Jesus%2C%20I%20am%20interested%20in%20your%20mobile%20architecture%20consulting%20services." target="_blank" rel="noopener noreferrer" class="button btn-titanium">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.97.549 1.742.883 2.796.883 3.183 0 5.77-2.587 5.77-5.766.001-3.182-2.585-5.769-5.77-5.769zm10.154 5.767c0 5.614-4.57 10.183-10.185 10.183-1.782 0-3.453-.464-4.912-1.272l-5.688 1.492 1.517-5.541c-.896-1.503-1.402-3.256-1.402-5.132 0-5.614 4.568-10.184 10.185-10.184 5.615 0 10.185 4.57 10.185 10.184z"/></svg>
          <span>Direct WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Secondary Modernization Hook -->
    <div class="secondary-offering-hook">
      <a href="#products" class="hook-link">
        <span>Are you planning to develop your mobile app from scratch? Explore Zora KMP Starter Kit.</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .section-subtitle {
    margin-bottom: 2.75rem;
  }

  .pathways-block {
    margin-bottom: 1rem;
  }

  .pathways-header {
    margin-bottom: 1.5rem;
  }

  .pathways-title {
    font-size: 1.4rem;
    color: #ffffff;
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  /* Pathways Grid */
  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pathway-glow {
    position: absolute;
    top: -20%;
    right: -20%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(72, 165, 116, 0.2) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .pathway-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .pathway-option-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-engraved);
    letter-spacing: 0.06em;
  }

  .pathway-option-label.highlight {
    color: var(--anodized-green-edge);
  }

  .pathway-name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .architecture-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-laser-white);
    margin-bottom: 1rem;
  }

  .architecture-pill.pill-anodized {
    background: rgba(37, 87, 62, 0.25);
    border-color: rgba(72, 165, 116, 0.4);
    color: var(--anodized-green-edge);
  }

  .pathway-description {
    font-size: 0.9rem;
    color: var(--text-laser-white);
    line-height: 1.5;
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .pathways-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Workflow Block Styles */
  .workflow-block {
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .workflow-header {
    margin-bottom: 2rem;
  }

  .workflow-title {
    font-size: 1.45rem;
    color: #ffffff;
    margin-top: 0.35rem;
    letter-spacing: -0.02em;
  }

  .workflow-subtitle {
    font-size: 0.95rem;
    color: var(--text-metal-secondary);
    line-height: 1.5;
    max-width: 720px;
    margin-top: 0.4rem;
  }

  .workflow-stages-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .stage-tag-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stage-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-engraved);
    letter-spacing: 0.06em;
  }

  .stage-badge.badge-green {
    color: var(--anodized-green-edge);
  }

  .stage-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .stage-focus-box {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1rem;
  }

  .stage-focus-box.focus-box-green {
    background: rgba(37, 87, 62, 0.25);
    border-color: rgba(72, 165, 116, 0.4);
    color: var(--anodized-green-edge);
  }

  .focus-label {
    font-weight: 700;
    color: var(--text-metal-secondary);
  }

  .focus-value {
    color: var(--text-laser-white);
  }

  .stage-deliverables-text {
    font-size: 0.88rem;
    color: var(--text-laser-white);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .stage-deliverables-text strong {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .workflow-stages-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Assessment Block Styles */
  .assessment-block {
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .assessment-card {
    padding: clamp(1.75rem, 4vw, 2.5rem);
  }

  .assessment-header {
    margin-bottom: 2rem;
  }

  .assessment-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .assessment-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .assessment-subtitle {
    font-size: 0.95rem;
    color: var(--text-metal-secondary);
    line-height: 1.55;
    max-width: 780px;
  }

  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .deliverable-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .deliverable-badge {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(37, 87, 62, 0.35);
    border: 1px solid rgba(72, 165, 116, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .deliverable-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--anodized-green-edge);
  }

  .deliverable-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .deliverable-desc {
    font-size: 0.85rem;
    color: var(--text-metal-secondary);
    line-height: 1.5;
  }

  .action-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .action-caption p {
    font-size: 0.92rem;
    color: var(--text-laser-white);
  }

  @media (max-width: 900px) {
    .deliverables-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
