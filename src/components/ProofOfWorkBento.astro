<style>
  .section-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .section-title {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }

  .section-subtitle {
    color: var(--text-metal-secondary);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .bay-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .bay-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .machined-link-btn {
    color: var(--text-engraved);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--chamfer-subtle);
    border-radius: 8px;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .machined-link-btn:hover {
    color: var(--anodized-green-edge);
    border-color: rgba(118, 227, 171, 0.4);
    background: rgba(37, 87, 62, 0.2);
    transform: translateY(-1px);
  }

  .bay-title {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    color: #ffffff;
    letter-spacing: -0.025em;
  }

  .bay-description {
    color: var(--text-metal-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .bay-description strong {
    color: #ffffff;
  }

  .machined-code-terminal {
    background: #090a0d;
    border: 1px solid var(--chamfer-subtle);
    border-top: 1px solid var(--chamfer-light);
    border-radius: 12px;
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--anodized-green-edge);
    margin-bottom: 1.5rem;
    overflow-x: auto;
  }

  .terminal-bezel {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .terminal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--anodized-green-edge);
    box-shadow: 0 0 6px var(--anodized-green-edge);
  }

  .platform-spec {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--text-engraved);
    font-weight: 600;
  }

  .bay-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .metal-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-metal-secondary);
  }
</style>

<script>
  // Procedural 3D Tilt & Anisotropic Light Tracking (0 KB external assets)
  const tiltCards = document.querySelectorAll('[data-tilt]');

  tiltCards.forEach((cardEl) => {
    const card = cardEl as HTMLElement;

    card.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const deltaX = (x - centerX) / centerX; // -1 to 1
      const deltaY = (y - centerY) / centerY; // -1 to 1

      // Subtle tilt max 5 degrees for realistic hardware resistance
      const rotateX = -deltaY * 5;
      const rotateY = deltaX * 5;

      card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.01, 1.01, 1.01)`;
      card.style.setProperty('--mouse-x', `${x.toFixed(1)}px`);
      card.style.setProperty('--mouse-y', `${y.toFixed(1)}px`);
    });

    card.addEventListener('pointerleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  });
</script>
