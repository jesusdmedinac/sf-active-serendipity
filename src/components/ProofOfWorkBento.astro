    <p class="section-subtitle">Real cross-platform codebases, open-source tooling, and architectures running in production.</p>
  </div>

  <div class="bento-grid">
    <!-- Tile 1: json-to-compose (Hero Bay - 8 cols) -->
    <div class="tilt-card-wrapper col-span-8">
      <div class="bento-card-titanium featured-bay" data-tilt>
        <div class="anisotropic-sheen"></div>

        <div class="bay-header">
          <div class="bay-metadata">
            <span class="engraved-label">OPEN SOURCE ENGINE</span>
            <span class="badge-metal badge-scorched-violet">Compose Multiplatform</span>
            <span class="badge-metal badge-anodized-green">Server-Driven UI</span>
          </div>
          <a href="https://github.com/jesusdmedinac/json-to-compose" target="_blank" rel="noopener noreferrer" class="machined-link-btn" aria-label="View json-to-compose on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>

        <div class="bay-body">
          <h3 class="bay-title">json-to-compose</h3>
          <p class="bay-description">
            High-performance Server-Driven UI & Generative UI engine enabling dynamic, remote-driven rendering of native UI trees. Bridges raw JSON AST configurations directly into Compose Multiplatform components across <strong>Android, iOS, Desktop, and WASM</strong> with zero performance degradation.
          </p>

          <!-- Machined Code Console Terminal -->
          <div class="machined-code-terminal">
            <div class="terminal-bezel">
              <span class="terminal-dot"></span>
              <span class="engraved-label">DynamicTreeParser.kt</span>
              <span class="platform-spec">TARGET: IOS & ANDROID NATIVE</span>
            </div>
            <code>val nativeTree = JsonToCompose.render(jsonAst, platform = Platform.iOS)</code>
          </div>
        </div>

        <div class="bay-footer">
          <span class="metal-tag">Kotlin Multiplatform</span>
          <span class="metal-tag">AST Parsing</span>
          <span class="metal-tag">Jetpack Compose</span>
          <span class="metal-tag">Swift Interop</span>
        </div>
      </div>
    </div>

    <!-- Tile 2: from-0-dev / Desde0 Academy (4 cols) -->
    <div class="tilt-card-wrapper col-span-4">
      <div class="bento-card-titanium" data-tilt>
        <div class="anisotropic-sheen"></div>

        <div class="bay-header">
          <div class="bay-metadata">
            <span class="engraved-label">INCUBATOR & ACADEMY</span>
            <span class="badge-metal">Ecosystem & Community</span>
          </div>
          <a href="https://desde0.jesusdmedinac.com" target="_blank" rel="noopener noreferrer" class="machined-link-btn" aria-label="Visit Desde0 Academy">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>

        <div class="bay-body">
          <h3 class="bay-title">from-0-dev (Desde0 Academy)</h3>
