          <span class="metal-tag">Zero JVM Latency</span>
          <span class="metal-tag">CLI Systems</span>
        </div>
      </div>
    </div>

    <!-- Tile 4: kotlin-0-dev (6 cols) -->
    <div class="tilt-card-wrapper col-span-6">
      <div class="bento-card-titanium" data-tilt>
        <div class="anisotropic-sheen"></div>

        <div class="bay-header">
          <div class="bay-metadata">
            <span class="engraved-label">ARCHITECTURE PATTERNS</span>
            <span class="badge-metal badge-anodized-green">Clean Core</span>
            <span class="badge-metal">Architecture</span>
          </div>
          <a href="https://github.com/jesusdmedinac" target="_blank" rel="noopener noreferrer" class="machined-link-btn" aria-label="View Kotlin architecture on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
