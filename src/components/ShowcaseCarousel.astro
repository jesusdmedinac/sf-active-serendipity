---
// ShowcaseCarousel.astro: JetBrains-style Production Showcase Carousel
// Pixel-perfect alignment with kotlinlang.org/compose-multiplatform
// Zero layout shifts, proportional natural image rendering, 48px outline nav buttons
export interface Slide {
  id: number;
  image: string;
  app: string;
  description: string;
}

const slides: Slide[] = [
  {
    id: 1,
    image: '/images/carousel/gallery-img-3.png',
    app: 'Feres',
    description: 'Feres, a taxi app with 1M+ downloads, shares all business logic with KMP and 90% of its UI using Compose Multiplatform.'
  },
  {
    id: 2,
    image: '/images/carousel/gallery-img-1.png',
    app: 'Markaz',
    description: 'Markaz, Pakistan’s e-commerce platform with 5M+ downloads, has 100+ screens built entirely with Compose Multiplatform.'
  },
  {
    id: 3,
    image: '/images/carousel/gallery-img-5.png',
    app: 'Respawn',
    description: 'Respawn, your coach on lasting habits, is using Compose Multiplatform with 96% shared code.'
  },
  {
    id: 4,
    image: '/images/carousel/gallery-img-7.png',
    app: 'Fast&Fit',
    description: 'The Fast&Fit app shares over 90% of its codebase – including the entire UI – using KMP and Compose Multiplatform.'
  },
  {
    id: 5,
    image: '/images/carousel/gallery-img-6.png',
    app: 'Music Work',
    description: 'Music Work, a playlist player with brand-tailored content, is built with Compose Multiplatform for mobile, desktop, and web.'
  },
  {
    id: 6,
    image: '/images/carousel/gallery-img-4.png',
    app: 'Physics Wallah',
    description: 'Physics Wallah, an educational platform with 17M active users, unified both UI and business logic across iOS and Android.'
  },
  {
    id: 7,
    image: '/images/carousel/gallery-img-2.png',
    app: 'Wrike',
    description: 'Wrike apps feature Calendars, Boards, Dashboards, Charts, Timesheet Approvals, and more – all done with Compose Multiplatform.'
  },
  {
    id: 8,
    image: '/images/carousel/gallery-img-8.png',
    app: 'BiliBili',
    description: 'BiliBili (China version) has adopted Kotlin Multiplatform and Compose Multiplatform for its Instant Message feature.'
  }
];
---

<div 
  class="jb-carousel relative w-full overflow-hidden rounded-2xl sm:rounded-3xl lg:rounded-[32px] border border-white/12 flex flex-col" 
  id="showcase-carousel" 
  aria-label="Production showcase carousel"
>
  <!-- Slides Stage: Dynamic natural image sizing (active slide defines height, no layout jump) -->
  <div class="jb-slides-stage relative w-full overflow-hidden">
    {slides.map((slide, index) => (
      <div 
        class={`jb-slide ${index === 0 ? 'is-active' : ''}`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={`${slide.app} - Compose Multiplatform in production`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full h-auto block select-none pointer-events-none"
          draggable="false"
        />
      </div>
    ))}
  </div>

  <!-- Bottom Info & Controls Bar (JetBrains seamless #19191c without border-t) -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:gap-6 p-5 sm:p-6 bg-[#19191c] w-full box-border border-0">
    <div class="flex-1 overflow-hidden w-full">
      <!-- Stepped min-height reservation to eliminate CLS (72px desktop / 48px tablet / 60px mobile / 80px small mobile) -->
      <div class="jb-text-wrapper relative">
        {slides.map((slide, index) => (
          <p 
            class={`jb-text-item ${index === 0 ? 'is-active' : ''}`}
            data-text-index={index}
          >
            {slide.description}
          </p>
        ))}
      </div>
    </div>

    <!-- Navigation Buttons: JetBrains 48px circular outline buttons -->
    <div class="flex w-full md:w-auto justify-between md:justify-end items-center gap-4 sm:gap-6 select-none self-center shrink-0">
      <button type="button" class="jb-nav-btn" id="carousel-prev" aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button type="button" class="jb-nav-btn" id="carousel-next" aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Subtle Progress Line -->
  <div class="w-full h-[2px] bg-white/[0.08]">
    <div class="h-full w-0 transition-[width] duration-100 ease-linear [background:var(--zora-gradient)]" id="progress-bar-fill"></div>
  </div>
</div>

<style>
  .jb-carousel {
    background: linear-gradient(180deg, rgba(138, 77, 255, 0.45) 0%, rgba(32, 16, 58, 0.95) 100%);
    box-shadow: 
      0 20px 40px -12px rgba(0, 0, 0, 0.8),
      0 0 32px -8px rgba(138, 77, 255, 0.25);
  }

  /* Stage & Slides */
  .jb-slides-stage {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .jb-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateX(100%);
    transition: transform 0.35s ease-in-out, opacity 0.35s ease-in-out;
    pointer-events: none;
  }

  .jb-slide.is-active {
    position: relative;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .jb-slide.is-prev {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .jb-slide.is-next {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Stepped Text Reservation */
  .jb-text-wrapper {
    position: relative;
    min-height: 80px;
  }
  @media (min-width: 473px) {
    .jb-text-wrapper {
      min-height: 60px;
    }
  }
  @media (min-width: 768px) {
    .jb-text-wrapper {
      min-height: 48px;
    }
  }
  @media (min-width: 1024px) {
    .jb-text-wrapper {
      min-height: 72px;
    }
  }

  .jb-text-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    font-size: 13px;
    line-height: 20px;
    color: #c0c7d2;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .jb-text-item {
      font-size: 14px;
      line-height: 22px;
    }
  }

  .jb-text-item.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  /* Circular Outline Buttons */
  .jb-nav-btn {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  @media (max-width: 639px) {
    .jb-nav-btn {
      width: 42px;
      height: 42px;
      min-width: 42px;
      min-height: 42px;
    }
  }

  .jb-nav-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-1px);
  }

  .jb-nav-btn:active {
    transform: translateY(1px);
    background: rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  function setupJbCarousel() {
    const container = document.getElementById('showcase-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.jb-slide');
    const texts = container.querySelectorAll<HTMLElement>('.jb-text-item');
    const progressFill = document.getElementById('progress-bar-fill');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    const totalSlides = slides.length;
    let currentIndex = 0;
    const intervalMs = 5000;
    let startTime = Date.now();
    let isPaused = false;
    let progressAnimId: number | null = null;

    function showSlide(newIndex: number, forward = true) {
      if (newIndex === currentIndex) return;
      const oldIndex = currentIndex;
      currentIndex = newIndex;

      slides.forEach((slide, i) => {
        slide.classList.remove('is-active', 'is-prev', 'is-next');
        slide.style.transition = '';
        slide.style.transform = '';

        if (i === currentIndex) {
          if (!forward) {
            slide.style.transition = 'none';
            slide.style.transform = 'translateX(-100%)';
            slide.style.opacity = '0';
            void slide.offsetWidth; // Force reflow
            slide.style.transition = '';
          }
          slide.classList.add('is-active');
        } else if (i === oldIndex) {
          if (forward) {
            slide.classList.add('is-prev');
          } else {
            slide.classList.add('is-next');
          }
        } else {
          slide.classList.add(forward ? 'is-next' : 'is-prev');
        }
      });

      texts.forEach((text, i) => {
        text.classList.toggle('is-active', i === currentIndex);
      });

      startTime = Date.now();
    }

    function nextSlide() {
      const next = (currentIndex + 1) % totalSlides;
      showSlide(next, true);
    }

    function prevSlide() {
      const prev = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(prev, false);
    }

    function tickProgress() {
      if (!isPaused && progressFill) {
        const elapsed = Date.now() - startTime;
        const pct = Math.min((elapsed / intervalMs) * 100, 100);
        progressFill.style.width = `${pct}%`;
        if (elapsed >= intervalMs) {
          nextSlide();
        }
      }
      progressAnimId = requestAnimationFrame(tickProgress);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
      });
    }

    // Hover pause
    container.addEventListener('mouseenter', () => {
      isPaused = true;
    });

    container.addEventListener('mouseleave', () => {
      isPaused = false;
      startTime = Date.now();
    });

    // Touch swipe support
    let touchStartX = 0;
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      isPaused = false;
      startTime = Date.now();
    }, { passive: true });

    progressAnimId = requestAnimationFrame(tickProgress);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupJbCarousel);
  } else {
    setupJbCarousel();
  }
</script>
