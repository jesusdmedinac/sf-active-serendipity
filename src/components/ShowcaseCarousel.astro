---
// ShowcaseCarousel.astro: JetBrains-style Production Showcase Carousel
// Precision responsive layout across sm (640px), md (768px), lg (1024px), xl (1280px)
export interface Slide {
  id: number;
  image: string;
  app: string;
  description: string;
}

const slides: Slide[] = [
  {
    id: 1,
    image: '/images/carousel/gallery-img-3.png',
    app: 'Feres',
    description: 'Feres, a taxi app with 1M+ downloads, shares all business logic with KMP and 90% of its UI using Compose Multiplatform.'
  },
  {
    id: 2,
    image: '/images/carousel/gallery-img-1.png',
    app: 'Markaz',
    description: 'Markaz, Pakistan’s e-commerce platform with 5M+ downloads, has 100+ screens built entirely with Compose Multiplatform.'
  },
  {
    id: 3,
    image: '/images/carousel/gallery-img-5.png',
    app: 'Respawn',
    description: 'Respawn, your coach on lasting habits, is using Compose Multiplatform with 96% shared code.'
  },
  {
    id: 4,
    image: '/images/carousel/gallery-img-7.png',
    app: 'Fast&Fit',
    description: 'The Fast&Fit app shares over 90% of its codebase – including the entire UI – using KMP and Compose Multiplatform.'
  },
  {
    id: 5,
    image: '/images/carousel/gallery-img-6.png',
    app: 'Music Work',
    description: 'Music Work, a playlist player with brand-tailored content, is built with Compose Multiplatform for mobile, desktop, and web.'
  },
  {
    id: 6,
    image: '/images/carousel/gallery-img-4.png',
    app: 'Physics Wallah',
    description: 'Physics Wallah, an educational platform with 17M active users, unified both UI and business logic across iOS and Android.'
  },
  {
    id: 7,
    image: '/images/carousel/gallery-img-2.png',
    app: 'Wrike',
    description: 'Wrike apps feature Calendars, Boards, Dashboards, Charts, Timesheet Approvals, and more – all done with Compose Multiplatform.'
  },
  {
    id: 8,
    image: '/images/carousel/gallery-img-8.png',
    app: 'BiliBili',
    description: 'BiliBili (China version) has adopted Kotlin Multiplatform and Compose Multiplatform for its Instant Message feature.'
  }
];
---

<div class="jb-carousel" id="showcase-carousel" aria-label="Production showcase carousel">
  <!-- Slides Stage: Large screen gallery -->
  <div class="jb-slides-stage">
    {slides.map((slide, index) => (
      <div 
        class={`jb-slide ${index === 0 ? 'is-active' : ''}`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={`${slide.app} - Compose Multiplatform in production`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="jb-slide-image"
        />
      </div>
    ))}
  </div>

  <!-- Bottom Info & Controls Bar (JetBrains Style) -->
  <div class="jb-carousel-controls">
    <div class="jb-text-container">
      <div class="jb-text-wrapper">
        {slides.map((slide, index) => (
          <p 
            class={`jb-text-item ${index === 0 ? 'is-active' : ''}`}
            data-text-index={index}
          >
            {slide.description}
          </p>
        ))}
      </div>
    </div>

    <!-- Navigation Buttons with minimal 1px outline -->
    <div class="jb-carousel-buttons">
      <button type="button" class="jb-nav-btn" id="carousel-prev" aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button type="button" class="jb-nav-btn" id="carousel-next" aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Subtle Progress Line -->
  <div class="jb-progress-track">
    <div class="jb-progress-bar" id="progress-bar-fill"></div>
  </div>
</div>

<style>
  /* Base (Mobile-First < 640px) */
  .jb-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(138, 77, 255, 0.45) 0%, rgba(32, 16, 58, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
      0 20px 40px -12px rgba(0, 0, 0, 0.8),
      0 0 32px -8px rgba(138, 77, 255, 0.25);
    display: flex;
    flex-direction: column;
  }

  /* Slides Stage */
  .jb-slides-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1400 / 1200;
    overflow: hidden;
    background: #090a0d;
  }

  .jb-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.4s ease-in-out, transform 0.4s ease-in-out;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .jb-slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .jb-slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Bottom Controls & Editorial Quotes */
  .jb-carousel-controls {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 18px 20px 14px;
    background: #15181e;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .jb-text-container {
    flex: 1;
    overflow: hidden;
  }

  .jb-text-wrapper {
    position: relative;
    min-height: 64px;
  }

  .jb-text-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    font-size: 13px;
    line-height: 20px;
    color: #c0c7d2;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    pointer-events: none;
  }

  .jb-text-item.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  /* Buttons: full width with spread out arrows in mobile for thumb ergonomics */
  .jb-carousel-buttons {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .jb-nav-btn {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .jb-nav-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .jb-nav-btn:active {
    transform: translateY(1px);
    background: rgba(255, 255, 255, 0.08);
  }

  /* Progress Line */
  .jb-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .jb-progress-bar {
    width: 0%;
    height: 100%;
    background: var(--zora-gradient);
    transition: width 0.1s linear;
  }

  /* Breakpoint: Small Mobile (width <= 472px) */
  @media (max-width: 472px) {
    .jb-text-wrapper {
      min-height: 80px;
    }
  }

  /* Breakpoint: sm (width >= 40rem / 640px) */
  @media (min-width: 40rem) {
    .jb-carousel {
      border-radius: 24px;
    }

    .jb-carousel-controls {
      padding: 22px 24px 18px;
    }

    .jb-text-item {
      font-size: 14px;
      line-height: 22px;
    }
  }

  /* Breakpoint: md / tablet (width >= 48rem / 768px) */
  @media (min-width: 48rem) {
    .jb-carousel-controls {
      flex-direction: row;
      gap: 24px;
      align-items: flex-start;
      padding: 24px;
    }

    .jb-text-wrapper {
      min-height: 54px;
    }

    .jb-carousel-buttons {
      width: auto;
      gap: 16px;
      align-self: center;
      margin-top: 0;
    }
  }

  /* Breakpoint: lg / desktop (width >= 64rem / 1024px) */
  @media (min-width: 64rem) {
    .jb-carousel {
      border-radius: 32px;
      max-width: 540px;
    }

    .jb-slides-stage {
      aspect-ratio: 1400 / 1260;
    }

    .jb-text-wrapper {
      min-height: 68px;
    }
  }

  /* Breakpoint: xl (width >= 80rem / 1280px) */
  @media (min-width: 80rem) {
    .jb-carousel {
      max-width: 600px;
    }

    .jb-text-wrapper {
      min-height: 72px;
    }
  }
</style>

<script>
  function setupJbCarousel() {
    const container = document.getElementById('showcase-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.jb-slide');
    const texts = container.querySelectorAll<HTMLElement>('.jb-text-item');
    const progressFill = document.getElementById('progress-bar-fill');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    const totalSlides = slides.length;
    let currentIndex = 0;
    const intervalMs = 5000;
    let startTime = Date.now();
    let isPaused = false;
    let progressAnimId: number | null = null;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
      texts.forEach((text, i) => {
        text.classList.toggle('is-active', i === index);
      });
      startTime = Date.now();
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      showSlide(currentIndex);
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(currentIndex);
    }

    function tickProgress() {
      if (!isPaused && progressFill) {
        const elapsed = Date.now() - startTime;
        const pct = Math.min((elapsed / intervalMs) * 100, 100);
        progressFill.style.width = `${pct}%`;
        if (elapsed >= intervalMs) {
          nextSlide();
        }
      }
      progressAnimId = requestAnimationFrame(tickProgress);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
      });
    }

    // Hover pause
    container.addEventListener('mouseenter', () => {
      isPaused = true;
    });

    container.addEventListener('mouseleave', () => {
      isPaused = false;
      startTime = Date.now();
    });

    // Touch swipe support
    let touchStartX = 0;
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      isPaused = false;
      startTime = Date.now();
    }, { passive: true });

    progressAnimId = requestAnimationFrame(tickProgress);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupJbCarousel);
  } else {
    setupJbCarousel();
  }
</script>
