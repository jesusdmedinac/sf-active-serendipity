---
// ShowcaseCarousel.astro: Production Proof-of-Reality Carousel (JetBrains style, ready for Zora)
export interface Slide {
  id: number;
  image: string;
  app: string;
  highlight: string;
  description: string;
}

const slides: Slide[] = [
  {
    id: 1,
    image: '/images/carousel/gallery-img-3.png',
    app: 'Feres',
    highlight: '1M+ downloads • 90% shared UI',
    description: 'Shares all business logic with KMP and 90% of its UI across iOS and Android using Compose Multiplatform.'
  },
  {
    id: 2,
    image: '/images/carousel/gallery-img-1.png',
    app: 'Markaz',
    highlight: '5M+ downloads • 100+ screens',
    description: 'E-commerce platform with 100+ screens built entirely with Compose Multiplatform for low and high-end hardware.'
  },
  {
    id: 3,
    image: '/images/carousel/gallery-img-5.png',
    app: 'Respawn',
    highlight: '96% shared code',
    description: 'Habit coaching application with 96% shared code and display-native framerates on iOS and Android.'
  },
  {
    id: 4,
    image: '/images/carousel/gallery-img-7.png',
    app: 'Fast&Fit',
    highlight: '90%+ shared codebase',
    description: 'Fitness ecosystem sharing over 90% of its codebase, including the entire responsive UI.'
  },
  {
    id: 5,
    image: '/images/carousel/gallery-img-6.png',
    app: 'Music Work',
    highlight: 'Mobile, Desktop & Web',
    description: 'Audio player running smoothly across mobile, desktop, and web targets from one codebase.'
  },
  {
    id: 6,
    image: '/images/carousel/gallery-img-4.png',
    app: 'Physics Wallah',
    highlight: '17M active users',
    description: 'Unified UI and business logic across iOS and Android, merging mobile engineers into a single high-velocity team.'
  },
  {
    id: 7,
    image: '/images/carousel/gallery-img-2.png',
    app: 'Wrike',
    highlight: 'Enterprise Production',
    description: 'Calendars, boards, interactive dashboards, and timesheet approvals in production with Compose Multiplatform.'
  },
  {
    id: 8,
    image: '/images/carousel/gallery-img-8.png',
    app: 'BiliBili',
    highlight: 'Instant Messaging Module',
    description: 'High-concurrency instant messaging module adopting Compose Multiplatform for fluid native rendering.'
  }
];
---

<div class="carousel-chassis" id="showcase-carousel" aria-label="Production showcase carousel">
  <!-- Top Bezel with Hardware Title & Indicators -->
  <div class="carousel-bezel">
    <div class="bezel-badge">
      <span class="live-dot"></span>
      <span class="bezel-title">PRODUCTION SHOWCASE</span>
    </div>
    <div class="carousel-counter" id="carousel-counter">
      <span class="current-index" id="current-index">01</span>
      <span class="counter-sep">/</span>
      <span class="total-count">{String(slides.length).padStart(2, '0')}</span>
    </div>
  </div>

  <!-- Stage: Slides Viewport -->
  <div class="slides-viewport">
    {slides.map((slide, index) => (
      <div 
        class={`slide-frame ${index === 0 ? 'is-active' : ''}`}
        data-slide-index={index}
      >
        <div class="image-wrapper">
          <img 
            src={slide.image} 
            alt={`${slide.app} - Compose Multiplatform in production`}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="slide-img"
          />
        </div>

        <!-- Captions Panel -->
        <div class="caption-card">
          <div class="caption-header">
            <h4 class="app-name">{slide.app}</h4>
            <span class="app-highlight">{slide.highlight}</span>
          </div>
          <p class="app-desc">{slide.description}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Navigation & Controls -->
  <div class="carousel-controls">
    <!-- Progress Line -->
    <div class="progress-bar-track">
      <div class="progress-bar-fill" id="progress-bar-fill"></div>
    </div>

    <!-- Manual Control Buttons -->
    <div class="nav-buttons">
      <button type="button" class="ctrl-btn" id="carousel-prev" aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button type="button" class="ctrl-btn" id="carousel-next" aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .carousel-chassis {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(160deg, #16181f 0%, #0d0e13 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 1rem 1rem 1.25rem;
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 20px 40px -10px rgba(0, 0, 0, 0.8),
      0 0 30px -5px rgba(138, 77, 255, 0.15);
    overflow: hidden;
  }

  .carousel-bezel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 12px;
  }

  .bezel-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--zora-magenta);
    box-shadow: 0 0 8px var(--zora-magenta);
  }

  .bezel-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-metal-secondary);
  }

  .carousel-counter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-engraved);
  }

  .current-index {
    color: #ffffff;
    font-weight: 700;
  }

  .counter-sep {
    color: rgba(255, 255, 255, 0.2);
    margin: 0 2px;
  }

  /* Slides Viewport */
  .slides-viewport {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: 14px;
    overflow: hidden;
    background: #090a0d;
  }

  .slide-frame {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .slide-frame.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(138, 77, 255, 0.08) 0%, transparent 70%);
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s ease;
  }

  .slide-frame.is-active .slide-img {
    transform: scale(1.02);
  }

  /* Caption Card */
  .caption-card {
    padding: 12px 14px;
    background: rgba(14, 16, 21, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .caption-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }

  .app-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .app-highlight {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--zora-orchid);
    letter-spacing: 0.02em;
  }

  .app-desc {
    font-size: 0.82rem;
    color: var(--text-metal-secondary);
    line-height: 1.45;
    margin: 0;
  }

  /* Controls */
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
    padding: 0 4px;
  }

  .progress-bar-track {
    flex-grow: 1;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    width: 0%;
    height: 100%;
    background: var(--zora-gradient);
    transition: width 0.1s linear;
  }

  .nav-buttons {
    display: flex;
    gap: 8px;
  }

  .ctrl-btn {
    min-width: 32px;
    min-height: 32px;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-laser-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--zora-orchid);
    color: #ffffff;
    transform: translateY(-1px);
  }
</style>

<script>
  function setupCarousel() {
    const container = document.getElementById('showcase-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.slide-frame');
    const currentIndexEl = document.getElementById('current-index');
    const progressFill = document.getElementById('progress-bar-fill');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    const totalSlides = slides.length;
    let currentIndex = 0;
    const intervalMs = 5000;
    let startTime = Date.now();
    let isPaused = false;
    let timerId: number | null = null;
    let progressAnimId: number | null = null;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
      if (currentIndexEl) {
        currentIndexEl.textContent = String(index + 1).padStart(2, '0');
      }
      startTime = Date.now();
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      showSlide(currentIndex);
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(currentIndex);
    }

    function tickProgress() {
      if (!isPaused && progressFill) {
        const elapsed = Date.now() - startTime;
        const pct = Math.min((elapsed / intervalMs) * 100, 100);
        progressFill.style.width = `${pct}%`;
        if (elapsed >= intervalMs) {
          nextSlide();
        }
      }
      progressAnimId = requestAnimationFrame(tickProgress);
    }

    // Controls
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
      });
    }

    // Hover pause
    container.addEventListener('mouseenter', () => {
      isPaused = true;
    });

    container.addEventListener('mouseleave', () => {
      isPaused = false;
      startTime = Date.now();
    });

    // Touch swipe support
    let touchStartX = 0;
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      isPaused = false;
      startTime = Date.now();
    }, { passive: true });

    // Start tick
    progressAnimId = requestAnimationFrame(tickProgress);
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCarousel);
  } else {
    setupCarousel();
  }
</script>
