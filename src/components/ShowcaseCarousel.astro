---
// ShowcaseCarousel.astro: JetBrains-style Production Showcase Carousel
// Migrated to Tailwind CSS v4 with native responsive layout and zero-CLS height reservation
export interface Slide {
  id: number;
  image: string;
  app: string;
  description: string;
}

const slides: Slide[] = [
  {
    id: 1,
    image: '/images/carousel/gallery-img-3.png',
    app: 'Feres',
    description: 'Feres, a taxi app with 1M+ downloads, shares all business logic with KMP and 90% of its UI using Compose Multiplatform.'
  },
  {
    id: 2,
    image: '/images/carousel/gallery-img-1.png',
    app: 'Markaz',
    description: 'Markaz, Pakistan’s e-commerce platform with 5M+ downloads, has 100+ screens built entirely with Compose Multiplatform.'
  },
  {
    id: 3,
    image: '/images/carousel/gallery-img-5.png',
    app: 'Respawn',
    description: 'Respawn, your coach on lasting habits, is using Compose Multiplatform with 96% shared code.'
  },
  {
    id: 4,
    image: '/images/carousel/gallery-img-7.png',
    app: 'Fast&Fit',
    description: 'The Fast&Fit app shares over 90% of its codebase – including the entire UI – using KMP and Compose Multiplatform.'
  },
  {
    id: 5,
    image: '/images/carousel/gallery-img-6.png',
    app: 'Music Work',
    description: 'Music Work, a playlist player with brand-tailored content, is built with Compose Multiplatform for mobile, desktop, and web.'
  },
  {
    id: 6,
    image: '/images/carousel/gallery-img-4.png',
    app: 'Physics Wallah',
    description: 'Physics Wallah, an educational platform with 17M active users, unified both UI and business logic across iOS and Android.'
  },
  {
    id: 7,
    image: '/images/carousel/gallery-img-2.png',
    app: 'Wrike',
    description: 'Wrike apps feature Calendars, Boards, Dashboards, Charts, Timesheet Approvals, and more – all done with Compose Multiplatform.'
  },
  {
    id: 8,
    image: '/images/carousel/gallery-img-8.png',
    app: 'BiliBili',
    description: 'BiliBili (China version) has adopted Kotlin Multiplatform and Compose Multiplatform for its Instant Message feature.'
  }
];
---

<div class="relative w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-white/12 shadow-[0_20px_40px_-12px_rgba(0,0,0,0.8),0_0_32px_-8px_rgba(138,77,255,0.25)] flex flex-col bg-gradient-to-b from-[#8A4DFF]/50 to-[#1a0836]/95" id="showcase-carousel" aria-label="Production showcase carousel">
  <!-- Slides Stage: Dynamic natural image sizing -->
  <div class="relative w-full overflow-hidden bg-[#090a0d]">
    {slides.map((slide, index) => (
      <div 
        class={`jb-slide absolute inset-0 w-full h-full opacity-0 pointer-events-none flex items-center justify-center transition-all duration-350 ease-in-out ${index === 0 ? 'is-active' : ''}`}
        data-slide-index={index}
      >
        <img 
          src={slide.image} 
          alt={`${slide.app} - Compose Multiplatform in production`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full h-auto block"
        />
      </div>
    ))}
  </div>

  <!-- Bottom Info & Controls Bar (JetBrains Style) -->
  <div class="flex flex-col md:flex-row gap-4 md:gap-6 p-5 sm:p-6 bg-[#19191c] w-full border-t border-white/8 box-border">
    <div class="flex-1 overflow-hidden">
      <!-- Stepped min-height reservation to eliminate CLS -->
      <div class="relative min-h-[80px] sm:min-h-[48px] lg:min-h-[72px]">
        {slides.map((slide, index) => (
          <p 
            class={`jb-text-item absolute top-0 left-0 w-full m-0 text-[13px] sm:text-sm leading-5 sm:leading-[22px] text-[#c0c7d2] opacity-0 transition-opacity duration-300 pointer-events-none ${index === 0 ? 'is-active' : ''}`}
            data-text-index={index}
          >
            {slide.description}
          </p>
        ))}
      </div>
    </div>

    <!-- Navigation Buttons with minimal outline -->
    <div class="flex w-full md:w-auto justify-between md:justify-end items-center gap-4 select-none self-center">
      <button type="button" class="w-10 h-10 min-w-10 min-h-10 p-0 rounded-full bg-white/5 border border-white/20 text-white inline-flex items-center justify-center cursor-pointer hover:bg-white/15 hover:border-white/45 hover:-translate-y-0.5 active:translate-y-0.5 active:bg-white/10 transition-all" id="carousel-prev" aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button type="button" class="w-10 h-10 min-w-10 min-h-10 p-0 rounded-full bg-white/5 border border-white/20 text-white inline-flex items-center justify-center cursor-pointer hover:bg-white/15 hover:border-white/45 hover:-translate-y-0.5 active:translate-y-0.5 active:bg-white/10 transition-all" id="carousel-next" aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Subtle Progress Line -->
  <div class="w-full h-0.5 bg-white/8">
    <div class="w-0 h-full transition-[width] duration-100 ease-linear [background:var(--zora-gradient)]" id="progress-bar-fill"></div>
  </div>
</div>

<style>
  /* Minimal dynamic state rules driven by JavaScript */
  .jb-slide {
    transform: translateX(100%);
  }
  .jb-slide.is-active {
    position: relative;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .jb-slide.is-prev {
    position: absolute;
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
  }
  .jb-text-item.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  function setupJbCarousel() {
    const container = document.getElementById('showcase-carousel');
    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.jb-slide');
    const texts = container.querySelectorAll<HTMLElement>('.jb-text-item');
    const progressFill = document.getElementById('progress-bar-fill');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    const totalSlides = slides.length;
    let currentIndex = 0;
    let prevIndex = -1;
    const intervalMs = 5000;
    let startTime = Date.now();
    let isPaused = false;
    let progressAnimId: number | null = null;

    function showSlide(newIndex: number, forward = true) {
      prevIndex = currentIndex;
      currentIndex = newIndex;

      slides.forEach((slide, i) => {
        slide.classList.remove('is-active', 'is-prev');

        if (i === currentIndex) {
          slide.style.transform = forward ? 'translateX(100%)' : 'translateX(-100%)';
          slide.style.opacity = '0';
          void slide.offsetWidth; // Reflow
          slide.classList.add('is-active');
          slide.style.transform = '';
          slide.style.opacity = '';
        } else if (i === prevIndex) {
          slide.classList.add('is-prev');
          slide.style.transform = forward ? 'translateX(-100%)' : 'translateX(100%)';
          slide.style.opacity = '0';
        } else {
          slide.style.transform = '';
          slide.style.opacity = '';
        }
      });

      texts.forEach((text, i) => {
        text.classList.toggle('is-active', i === currentIndex);
      });

      startTime = Date.now();
    }

    function nextSlide() {
      const next = (currentIndex + 1) % totalSlides;
      showSlide(next, true);
    }

    function prevSlide() {
      const prev = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(prev, false);
    }

    function tickProgress() {
      if (!isPaused && progressFill) {
        const elapsed = Date.now() - startTime;
        const pct = Math.min((elapsed / intervalMs) * 100, 100);
        progressFill.style.width = `${pct}%`;
        if (elapsed >= intervalMs) {
          nextSlide();
        }
      }
      progressAnimId = requestAnimationFrame(tickProgress);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
      });
    }

    container.addEventListener('mouseenter', () => {
      isPaused = true;
    });

    container.addEventListener('mouseleave', () => {
      isPaused = false;
      startTime = Date.now();
    });

    let touchStartX = 0;
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        nextSlide();
      } else if (touchEndX - touchStartX > 40) {
        prevSlide();
      }
      isPaused = false;
      startTime = Date.now();
    }, { passive: true });

    progressAnimId = requestAnimationFrame(tickProgress);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupJbCarousel);
  } else {
    setupJbCarousel();
  }
</script>
