---
// Dedicated Full-Screen Tablet Kiosk Mode: Physical Machined Titanium Field Instrument
import '../styles/global.css';
import QRCode from 'qrcode';
import Analytics from '../components/Analytics.astro';

// Build-time vector SVG QR code with in-person UTM attribution
const QR_TARGET_URL = 'https://jesusdmedinac.com/?utm_source=kiosk_qr&utm_medium=display&utm_campaign=sf_serendipity';
const qrSvg = await QRCode.toString(QR_TARGET_URL, {
  type: 'svg',
  margin: 1,
  color: {
    dark: '#0a0c0f',
    light: '#ffffff',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Jesús Medina | KMP Mobile Architecture Kiosk View</title>
    <link rel="canonical" href="https://jesusdmedinac.com/display" />
    <meta name="description" content="Kiosk view of Senior Android and KMP contracting ($35-$55/h), architecture audits, and 2-week sprints in Pacific Time." />
    <meta property="og:title" content="Jesús Medina | KMP Mobile Architecture Kiosk View" />
    <meta property="og:description" content="Senior Android and KMP contracting ($35-$55/h) in Pacific Time. Remote from Tijuana, Mexico (W-8BEN) or California on-site (TN)." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jesusdmedinac.com/display" />
    <meta property="og:image" content="https://jesusdmedinac.com/images/zora-cards.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jesús Medina | KMP Mobile Architecture Kiosk View" />
    <meta name="twitter:description" content="Senior Android and KMP contracting ($35-$55/h) in Pacific Time from Tijuana and California." />
    <meta name="twitter:image" content="https://jesusdmedinac.com/images/zora-cards.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Field Kiosk" />
    <Analytics />
  </head>
  <body class="kiosk-body">
    <!-- Physical Instrument Chassis Frame -->
    <div class="chassis-outer">
      <div class="chassis-bevel">
        <main class="kiosk-viewport">
          <!-- Top Telemetry Instrumentation Bar -->
          <header class="kiosk-telemetry-bar">
            <div class="telemetry-item">
              <span class="led-diode-green"></span>
              <span class="telemetry-val">PACIFIC TIME · PST</span>
            </div>

            <div class="telemetry-item wakelock-box" id="wakelock-status">
              <span class="status-active">AVAILABLE JAN 4</span>
            </div>

            <button id="fullscreen-btn" class="button btn-titanium fs-btn" aria-label="Toggle Fullscreen">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
              <span>FULLSCREEN</span>
            </button>
          </header>

          <!-- Main Instrument Stage -->
          <div class="instrument-stage">
            <!-- Left: Rotating Diagnostic Telemetry Hook -->
            <div class="telemetry-column">
              <div class="operator-id">
                <p class="operator-name">Jesús Daniel Medina Cruz</p>
                <span class="operator-role">Senior Mobile Platform Architect | Android & Kotlin Multiplatform</span>
              </div>

              <div class="hook-rotator" id="hook-rotator">
                <!-- Slide 1: Zora Violet -->
                <div class="hook-slide active" data-index="0">
                  <span class="badge-metal badge-scorched-violet">KOTLIN MULTIPLATFORM</span>
                  <h1 class="slide-headline">
                    Native iOS & Android from a single Kotlin codebase.
                  </h1>
                  <p class="slide-sub">
                    Shared Kotlin business logic, networking, and persistence paired with native Jetpack Compose and SwiftUI interfaces.
                  </p>
                </div>

                <!-- Slide 2: Pacific Time / Cross-Border -->
                <div class="hook-slide" data-index="1">
                  <span class="badge-metal badge-anodized-green">TIJUANA · SAN DIEGO · PST</span>
                  <h2 class="slide-headline">
                    Available Jan 4 for Senior Android & KMP contracts.
                  </h2>
                  <p class="slide-sub">
                    20–40 h/week in Pacific Time. Remote from Tijuana, Mexico (W-8BEN) or San Diego and California on-site (TN).
                  </p>
                </div>

                <!-- Slide 3: Contract & Consulting -->
                <div class="hook-slide" data-index="2">
                  <span class="badge-metal badge-scorched-violet">CONTRACT & ADVISORY</span>
                  <h2 class="slide-headline">
                    Senior Contracting, Audits & KMP Pilot Sprints.
                  </h2>
                  <p class="slide-sub">
                    Senior Contract Engineering ($35–$55/h), Architecture Audits ($3k), and 2-Week KMP Sprints ($3.5k).
                  </p>
                </div>
              </div>

              <!-- Slide progress indicators -->
              <div class="slide-indicators">
                <span class="indicator-segment active dot-green" data-dot="0"></span>
                <span class="indicator-segment dot-duo" data-dot="1"></span>
                <span class="indicator-segment dot-violet" data-dot="2"></span>
              </div>
            </div>

            <!-- Right: Machined Alloy Plate with Vector QR -->
            <div class="qr-column">
              <div class="alloy-plate">
                <div class="plate-chamfer-border">
                  <div class="qr-svg-wrapper" set:html={qrSvg}></div>
                  <div class="qr-plate-label">
                    <a href="/" class="target-domain" style="text-decoration: none;">jesusdmedinac.com</a>
                    <span class="spec-sep"> · </span>
                    <a href="/#consulting" class="target-domain" style="text-decoration: none;">Services</a>
                    <span class="spec-sep"> · </span>
                    <a href="/zora-kmp" class="target-domain" style="text-decoration: none;">Zora KMP</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Telemetry Ticker -->
          <footer class="instrument-footer">
            <div class="spec-ticker">
              <span class="spec-label">CORE ARCHITECTURE:</span>
              <span class="spec-val">Kotlin Multiplatform (KMP)</span>
              <span class="spec-sep">•</span>
              <span class="spec-val">Jetpack Compose & SwiftUI</span>
              <span class="spec-sep">•</span>
              <span class="spec-val">AI-Native Delivery</span>
              <span class="spec-sep">•</span>
              <span class="spec-val">Senior Contracting ($35–$55/h)</span>
              <span class="spec-sep">•</span>
              <span class="spec-val">Pacific Time (PST)</span>
            </div>
          </footer>
        </main>
      </div>
    </div>

    <style>
      html, body.kiosk-body {
        margin: 0;
        padding: 0;
        width: 100vw;
        width: 100dvw;
        height: 100vh;
        height: 100dvh;
        max-height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow: hidden;
        overscroll-behavior: none;
        -webkit-overflow-scrolling: auto;
        touch-action: manipulation;
        background: #000000;
        display: flex;
        user-select: none;
        -webkit-user-select: none;
      }

      /* Chassis Outer Box (Edge-to-Edge Tablet Hardware Enclosure) */
      .chassis-outer {
        width: 100%;
        height: 100%;
        max-width: none;
        background: linear-gradient(180deg, #181c22 0%, #0c0e12 100%);
        border: none;
        border-top: 2px solid rgba(255, 255, 255, 0.35); /* CNC specular top highlight */
        border-radius: 0;
        padding: 6px;
        padding-top: calc(env(safe-area-inset-top, 0px) + 6px);
        padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 6px);
        padding-left: calc(env(safe-area-inset-left, 0px) + 6px);
        padding-right: calc(env(safe-area-inset-right, 0px) + 6px);
        box-sizing: border-box;
        box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.85);
        display: flex;
      }

      .chassis-bevel {
        position: relative;
        width: 100%;
        height: 100%;
        background: #090b0e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        box-sizing: border-box;
      }

      .cnc-screw {
        position: absolute;
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.22);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
        line-height: 1;
        z-index: 10;
        pointer-events: none;
      }
      .cnc-screw.top-left { top: 12px; left: 14px; }
      .cnc-screw.top-right { top: 12px; right: 14px; }
      .cnc-screw.bottom-left { bottom: 12px; left: 14px; }
      .cnc-screw.bottom-right { bottom: 12px; right: 14px; }

      .kiosk-viewport {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        padding: clamp(1rem, 2.8vw, 2.25rem);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-sizing: border-box;
      }

      /* Telemetry Header Bar */
      .kiosk-telemetry-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .telemetry-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.82rem;
      }

      .telemetry-val {
        color: var(--text-laser-white);
        font-weight: 600;
        background: rgba(255, 255, 255, 0.04);
        padding: 2px 6px;
        border-radius: 4px;
      }

      .wakelock-box .status-active {
        color: var(--anodized-green-edge);
        font-weight: 600;
      }

      .fs-btn {
        padding: 6px 14px;
        font-size: 0.8rem;
        min-height: 36px;
        border-radius: 8px;
      }

      /* Instrument Stage */
      .instrument-stage {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        align-items: center;
        gap: 3rem;
        margin: auto 0;
      }

      @media (max-width: 860px) {
        .instrument-stage {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          text-align: center;
        }
        .slide-indicators {
          justify-content: center;
        }
      }

      .telemetry-column {
        display: flex;
        flex-direction: column;
      }

      .operator-id {
        display: flex;
        flex-direction: column;
        margin-bottom: clamp(1rem, 2vh, 1.75rem);
      }

      .operator-name {
        margin: 0;
        font-size: clamp(1.4rem, 2.5vw, 1.95rem);
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.025em;
        line-height: 1.2;
      }

      .operator-role {
        font-family: var(--font-mono);
        font-size: clamp(0.85rem, 1.4vw, 1rem);
        color: var(--anodized-green-edge);
        letter-spacing: 0.02em;
        margin-top: 6px;
        font-weight: 500;
      }

      .hook-rotator {
        position: relative;
        min-height: 220px;
      }

      .hook-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        pointer-events: none;
      }

      .hook-slide.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      .slide-headline {
        font-size: clamp(2rem, 4vw, 3.1rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin: 12px 0;
        color: #ffffff;
      }

      .slide-sub {
        font-size: clamp(0.95rem, 1.8vw, 1.15rem);
        color: var(--text-metal-secondary);
        line-height: 1.5;
        max-width: 520px;
      }

      .slide-indicators {
        display: flex;
        gap: 8px;
        margin-top: 1.5rem;
      }

      .indicator-segment {
        width: 32px;
        height: 5px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 4px;
        transition: background 0.4s ease, width 0.4s ease, box-shadow 0.4s ease;
      }

      .indicator-segment.active.dot-green {
        background: #8A4DFF;
        width: 52px;
        box-shadow: 0 0 12px rgba(138, 77, 255, 0.7);
      }

      .indicator-segment.active.dot-duo {
        background: linear-gradient(90deg, #8A4DFF 0%, #ED158A 100%);
        width: 52px;
        box-shadow: 0 0 12px rgba(205, 0, 236, 0.7);
      }

      .indicator-segment.active.dot-violet {
        background: #ED158A;
        width: 52px;
        box-shadow: 0 0 12px rgba(237, 21, 138, 0.7);
      }

      /* Machined Alloy Plate for QR Code */
      .qr-column {
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .alloy-plate {
        background: linear-gradient(145deg, #242930 0%, #15181d 100%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-top: 2px solid rgba(255, 255, 255, 0.35); /* CNC chamfer */
        border-radius: 24px;
        padding: 1.25rem;
        box-shadow: 
          0 20px 50px -10px rgba(0, 0, 0, 0.9),
          0 0 35px -5px rgba(138, 77, 255, 0.25);
        width: 100%;
      }

      .plate-chamfer-border {
        background: #ffffff;
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .qr-svg-wrapper {
        width: 100%;
        aspect-ratio: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .qr-svg-wrapper :global(svg) {
        width: 100%;
        height: 100%;
        display: block;
      }

      .qr-plate-label {
        margin-top: 10px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .target-domain {
        font-family: var(--font-mono);
        font-size: 2rem;
        color: #090a0d;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      /* Instrument Footer Ticker */
      .instrument-footer {
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        text-align: center;
      }

      .spec-ticker {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 1rem;
        line-height: 1.4;
        color: var(--text-engraved);
      }

      .spec-label {
        color: #c9abff;
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .spec-val {
        color: var(--text-metal-secondary);
        font-weight: 500;
      }

      .spec-sep {
        color: rgba(255, 255, 255, 0.2);
      }
    </style>

    <script>
      // 1. WakeLock API to keep tablet screen awake
      let wakeLock: any = null;
      async function requestWakeLock() {
        if ('wakeLock' in navigator) {
          try {
            wakeLock = await (navigator as any).wakeLock.request('screen');
          } catch (err) {
            console.log('WakeLock error:', err);
          }
        }
      }
      requestWakeLock();

      document.addEventListener('visibilitychange', async () => {
        if (wakeLock !== null && document.visibilityState === 'visible') {
          await requestWakeLock();
        }
      });

      // 2. Fullscreen Toggle
      const fsBtn = document.getElementById('fullscreen-btn');
      const fsBtnText = fsBtn?.querySelector('span');
      function updateFsBtn() {
        if (document.fullscreenElement) {
          if (fsBtnText) fsBtnText.textContent = 'EXIT FULLSCREEN';
        } else {
          if (fsBtnText) fsBtnText.textContent = 'FULLSCREEN';
        }
      }
      fsBtn?.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().then(updateFsBtn).catch(() => {});
        } else {
          document.exitFullscreen().then(updateFsBtn).catch(() => {});
        }
      });
      document.addEventListener('fullscreenchange', updateFsBtn);

      // 3. Smooth Rotating Hooks every 6 seconds
      const slides = document.querySelectorAll('.hook-slide');
      const dots = document.querySelectorAll('.indicator-segment');
      let currentSlide = 0;

      function rotateSlide() {
        slides[currentSlide]?.classList.remove('active');
        dots[currentSlide]?.classList.remove('active');

        currentSlide = (currentSlide + 1) % slides.length;

        slides[currentSlide]?.classList.add('active');
        dots[currentSlide]?.classList.add('active');
      }

      setInterval(rotateSlide, 6000);

      // 4. Lock touchmove overscroll bounce on iPadOS Safari
      document.addEventListener('touchmove', (e) => {
        e.preventDefault();
      }, { passive: false });
    </script>
  </body>
</html>
