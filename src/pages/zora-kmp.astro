<span class="code-prop">name:</span> <span class="code-val">zora-kmp-starter</span>
<span class="code-prop">targets:</span>
  - <span class="code-val">android</span>
  - <span class="code-val">iosArm64</span>
  - <span class="code-val">iosSimulatorArm64</span>

<span class="code-prop">modules:</span>
  <span class="code-keyword">:apps:client:</span>
    <span class="code-prop">type:</span> compose-multiplatform-app
    <span class="code-prop">dependencies:</span>
      - <span class="code-val">:core:ai-copilot</span>
      - <span class="code-val">:core:sdui-compose</span>
      - <span class="code-val">:core:database-room</span>
      - <span class="code-val">io.insert-koin:koin-compose:4.0.0</span>
      - <span class="code-val">co.touchlab.skie:skie-annotations:0.9.4</span>

  <span class="code-keyword">:core:ai-copilot:</span>
    <span class="code-prop">engine:</span> google-ai-edge-nano
    <span class="code-prop">fallback:</span> gemini-flash-1.5
    <span class="code-prop">guardrails:</span> strict-domain-only</code></pre>
