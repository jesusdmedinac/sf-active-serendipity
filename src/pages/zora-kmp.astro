                    <div class="sdui-part-title">OEM Alternator Assembly (135A)</div>
                    <div class="sdui-part-meta">Part # 31100-5AA-A01 &bull; Fits 2016-2021 1.5L</div>
                    <div class="sdui-pricing-row">
                      <span class="sdui-status-chip">3 Yards In Stock</span>
                      <span class="sdui-price-est">Est. $85 – $120 USD</span>
                    </div>
                    <div class="sdui-actions">
                      <button class="sdui-btn sdui-btn-primary">Broadcast Part Request</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="mockup-footer-caption">
              Live Compose Multiplatform UI dynamically rendered via <code>json-to-compose</code>
            </div>
          </div>

          <!-- Code Architecture & Structure Inspector -->
