      .pain-card {
        border-color: rgba(237, 21, 138, 0.25);
        background: linear-gradient(180deg, rgba(237, 21, 138, 0.03) 0%, #0d0e12 100%);
      }

      .relief-card {
        border-color: rgba(167, 50, 253, 0.35);
        background: linear-gradient(180deg, rgba(167, 50, 253, 0.06) 0%, #0d0e12 100%);
        box-shadow: 0 0 30px rgba(167, 50, 253, 0.12);
      }

      .card-status-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .status-badge {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .badge-pain { color: #ff5c9d; }
      .badge-relief { color: #ff9cfd; }

      .status-time {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-engraved);
      }

      .status-time.highlight {
        color: #00E676;
        font-weight: 700;
      }

      .pain-list, .relief-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .pain-list li, .relief-list li {
        font-size: 0.88rem;
        line-height: 1.55;
        color: #bac4d2;
      }

      .pain-list strong { color: #ffffff; }
      .relief-list strong { color: #ffffff; }

      /* Pricing Section */
      .product-tiers-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .tier-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
      }

      .featured-tier-card {
        border-color: rgba(167, 50, 253, 0.45);
        box-shadow: 0 0 35px rgba(167, 50, 253, 0.15);
      }

      .featured-ribbon {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--zora-gradient);
        color: #ffffff;
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        padding: 3px 12px;
        border-radius: 20px;
        white-space: nowrap;
        box-shadow: 0 4px 12px rgba(167, 50, 253, 0.4);
      }

      .tier-badge-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
      }

      .tier-scope-tag {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 700;
        color: #b993f7;
        letter-spacing: 0.05em;
      }

      .tier-num {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-engraved);
      }

      .tier-num.highlight {
        color: #ff9cfd;
        font-weight: 700;
      }

      .tier-name {
        font-size: 1.35rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 0.5rem 0;
      }

      .tier-pricing {
        display: flex;
        align-items: baseline;
        gap: 4px;
        margin-bottom: 1rem;
      }

      .price-currency {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
      }

      .price-val {
        font-family: var(--font-mono);
        font-size: 2.75rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
      }

      .price-unit {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-engraved);
      }

      .tier-description {
        font-size: 0.88rem;
        color: var(--text-metal-secondary);
        line-height: 1.5;
        margin: 0 0 1.25rem 0;
      }

      .deliverables-list {
        list-style: none;
        padding: 0;
        margin: 0 0 1.75rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding-top: 1.25rem;
      }

      .deliverables-list li {
        font-size: 0.82rem;
        color: #bac4d2;
        line-height: 1.45;
        position: relative;
        padding-left: 14px;
      }

      .deliverables-list li::before {
        content: "›";
        position: absolute;
        left: 0;
        top: -1px;
        color: #A732FD;
        font-weight: bold;
        font-size: 0.95rem;
      }

      .deliverables-list strong {
        color: #ffffff;
      }

      .tier-btn {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0.75rem;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      /* Pricing Action Bar */
      .pricing-action-bar {
        background: #0a0b0e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1.25rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .action-tagline {
        font-size: 0.92rem;
        color: var(--text-laser-white);
        margin: 0;
      }

      .action-buttons-group {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      /* Table Container */
      .table-container {
        overflow-x: auto;
        background: #0d0f14;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 0.5rem;
      }

      .matrix-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        text-align: left;
      }

      .matrix-table th, .matrix-table td {
        padding: 0.85rem 1.15rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .matrix-table th {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-engraved);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .th-tier {
        text-align: center;
      }

      .matrix-table td:not(:first-child) {
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .highlight-col {
        background: rgba(167, 50, 253, 0.05);
        color: #ff9cfd;
        font-weight: 600;
      }

      /* Flagship Chassis 2-Col Grid (DRM) */
      .flagship-chassis-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .flagship-card {
        padding: 1.5rem;
      }

      .card-icon-tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        background: rgba(138, 77, 255, 0.15);
        color: #c9abff;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
        margin-bottom: 0.75rem;
      }

      .flagship-feature-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 0.5rem 0;
      }

      .flagship-feature-desc {
        font-size: 0.88rem;
        color: var(--text-metal-secondary);
        line-height: 1.55;
        margin: 0;
      }

      /* FAQ Grid */
      .faq-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      .faq-card {
        padding: 1.5rem;
      }

      .faq-question {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0 0 0.5rem 0;
      }

      .faq-answer {
        font-size: 0.88rem;
        color: var(--text-metal-secondary);
        line-height: 1.55;
        margin: 0;
      }

      .faq-answer strong {
        color: #ffffff;
      }

      /* Final CTA Block */
      .final-cta-block {
        margin-top: 5rem;
        margin-bottom: 3rem;
      }

      .machined-chassis {
        background: linear-gradient(180deg, #13151a 0%, #0a0b0e 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
      }

      .final-cta-title {
        font-size: clamp(1.8rem, 3.2vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #ffffff;
        margin: 0 0 0.75rem 0;
      }

      .final-cta-desc {
        font-size: 1.05rem;
        color: var(--text-metal-secondary);
        max-width: 650px;
        margin: 0 auto 2rem auto;
        line-height: 1.6;
      }

      .final-cta-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* Footer */
      .page-footer {
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding-top: 2rem;
      }

      .footer-copy {
        font-size: 0.85rem;
        color: var(--text-metal-secondary);
        margin: 0 0 0.35rem 0;
      }

      .footer-subcopy {
        font-size: 0.78rem;
        color: var(--text-engraved);
        margin: 0;
      }

      .link-inline {
        color: #c9abff;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @media (max-width: 900px) {
        .product-showcase-grid {
          grid-template-columns: 1fr;
        }
        .comparison-grid, .flagship-chassis-grid, .faq-grid {
          grid-template-columns: 1fr;
        }
        .product-tiers-grid {
          grid-template-columns: 1fr;
        }
        .pricing-action-bar {
          flex-direction: column;
          align-items: flex-start;
        }
        .action-buttons-group {
          width: 100%;
        }
        .action-buttons-group .button {
          flex: 1;
          justify-content: center;
        }
      }
    </style>
  </body>
</html>
