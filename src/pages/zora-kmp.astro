      .machined-card {
        background: var(--metal-gunmetal);
        border: 1px solid var(--chamfer-subtle);
        border-top: 1px solid var(--chamfer-light);
        border-radius: 8px;
        padding: 1.75rem;
      }

      .card-metric {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--zora-magenta);
        letter-spacing: 0.08em;
        margin-bottom: 0.75rem;
      }

      .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-laser-white);
        margin: 0 0 0.75rem;
      }

      .card-desc {
        font-size: 0.95rem;
        color: var(--text-metal-secondary);
        line-height: 1.55;
        margin: 0;
      }

      /* Tiers Stack */
      .tiers-stack {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .tier-detail-card {
        background: var(--metal-gunmetal);
        border: 1px solid var(--chamfer-subtle);
        border-top: 1px solid var(--chamfer-light);
        border-radius: 12px;
        padding: 2.25rem;
        transition: border-color 0.2s ease;
      }

      .featured-tier {
        border-color: rgba(138, 77, 255, 0.45);
        background: linear-gradient(180deg, rgba(22, 24, 29, 0.95) 0%, rgba(15, 17, 21, 0.98) 100%);
      }

      .enterprise-tier {
        border-color: rgba(237, 21, 138, 0.5);
        background: linear-gradient(180deg, rgba(29, 33, 39, 0.95) 0%, rgba(15, 17, 21, 0.98) 100%);
      }

      .tier-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }

      .tier-tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
        margin-bottom: 0.5rem;
      }

      .tag-open {
        background: rgba(255, 255, 255, 0.08);
        color: #d0d7e2;
      }

      .tag-commercial {
        background: rgba(138, 77, 255, 0.2);
        color: #d1b8ff;
      }

      .tag-enterprise {
        background: rgba(237, 21, 138, 0.2);
        color: #ff9dcb;
      }

      .tier-heading {
        font-size: 1.65rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--text-laser-white);
        margin: 0;
      }

      .tier-price-badge {
        text-align: right;
      }

      .price-fig {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text-laser-white);
      }

      .price-curr {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-engraved);
      }

      .tier-summary {
        font-size: 1.05rem;
        color: var(--text-metal-secondary);
        line-height: 1.6;
        margin: 0 0 1.75rem;
      }

      .feature-bullets {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        margin-bottom: 2rem;
      }

      .bullet-item {
        display: flex;
        gap: 0.85rem;
        font-size: 0.95rem;
        color: var(--text-metal-secondary);
        line-height: 1.5;
      }

      .bullet-item strong {
        color: var(--text-laser-white);
      }

      .check-icon {
        color: #8A4DFF;
        font-weight: 800;
      }

      .tier-cta-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--chamfer-subtle);
      }

      .cta-note {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--text-engraved);
      }

      /* Buttons */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.4rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffffff;
        background: #8A4DFF;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.15s ease;
      }

      .btn-primary:hover {
        background: #9d68ff;
        transform: translateY(-1px);
      }

      .btn-accent {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.4rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: #ffffff;
        background: var(--zora-gradient);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 6px;
        text-decoration: none;
        box-shadow: 0 4px 16px rgba(167, 50, 253, 0.25);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .btn-accent:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(167, 50, 253, 0.4);
      }

      .btn-subtle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.4rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-laser-white);
        background: var(--metal-steel-mid);
        border: 1px solid var(--chamfer-subtle);
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.15s ease, border-color 0.15s ease;
      }

      .btn-subtle:hover {
        background: var(--metal-steel-bright);
        border-color: var(--chamfer-light);
      }

      /* Matrix Table */
      .table-container {
        overflow-x: auto;
        background: var(--metal-gunmetal);
        border: 1px solid var(--chamfer-subtle);
        border-top: 1px solid var(--chamfer-light);
        border-radius: 8px;
      }

      .matrix-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.9rem;
      }

      .matrix-table th,
      .matrix-table td {
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--chamfer-subtle);
      }

      .matrix-table thead th {
        background: var(--metal-titanium);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--text-engraved);
      }

      .th-tier {
        text-align: center;
      }

      .matrix-table tbody td:nth-child(2),
      .matrix-table tbody td:nth-child(3),
      .matrix-table tbody td:nth-child(4) {
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }

      .matrix-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02);
      }

      .highlight-col {
        background: rgba(138, 77, 255, 0.04);
        color: #d1b8ff;
      }

      /* Concierge Box */
      .concierge-box {
        background: linear-gradient(135deg, rgba(22, 24, 29, 0.95) 0%, rgba(35, 20, 60, 0.6) 100%);
        border: 1px solid rgba(138, 77, 255, 0.4);
        border-radius: 12px;
        padding: 3rem 2rem;
        margin-bottom: 4rem;
        text-align: center;
      }

      .concierge-content {
        max-width: 680px;
        margin: 0 auto;
      }

      .concierge-title {
        font-size: clamp(1.8rem, 3.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text-laser-white);
        margin: 0.75rem 0 1rem;
      }

      .concierge-desc {
        font-size: 1.05rem;
        color: var(--text-metal-secondary);
        line-height: 1.6;
        margin: 0 0 2rem;
      }

      .concierge-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
      }

      /* Footer */
      .page-footer {
        text-align: center;
        padding-top: 2rem;
        border-top: 1px solid var(--chamfer-subtle);
      }

      .footer-copy {
        font-size: 0.9rem;
        color: var(--text-metal-secondary);
        margin: 0 0 0.35rem;
      }

      .footer-subcopy {
        font-size: 0.78rem;
        color: var(--text-engraved);
        margin: 0;
      }

      .link-inline {
        color: #b993f7;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: rgba(255, 255, 255, 0.08);
        padding: 0.15em 0.35em;
        border-radius: 3px;
        color: #d1b8ff;
      }
    </style>
  </body>
</html>
