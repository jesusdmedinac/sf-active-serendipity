---
// Main Entry Point for jesusdmedinac.com (SF Active Serendipity Portal)
import '../styles/global.css';
import AmbientShaderCanvas from '../components/AmbientShaderCanvas.astro';
import AtmosphericHero from '../components/AtmosphericHero.astro';
import SupportedPlatforms from '../components/SupportedPlatforms.astro';
import ProofOfWorkBento from '../components/ProofOfWorkBento.astro';
import ConsultingCard from '../components/ConsultingCard.astro';
import MigrationServices from '../components/MigrationServices.astro';
import ZoraProductShowcase from '../components/ZoraProductShowcase.astro';
import ContactGrid from '../components/ContactGrid.astro';
import Analytics from '../components/Analytics.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>Senior Android & KMP Architect | Jesús Medina (PST)</title>
    <link rel="canonical" href="https://jesusdmedinac.com/" />
    <meta name="description" content="Senior Android and Kotlin Multiplatform architect in PST. Available Jan 4 for remote contracts ($35-$55/h), architecture audits, and KMP migrations." />
    <meta property="og:title" content="Senior Android & KMP Architect | Jesús Medina (PST)" />
    <meta property="og:description" content="Senior Android and Kotlin Multiplatform contracting from Tijuana, Mexico (W-8BEN) or California on-site (TN). 11 years building mobile platforms." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jesusdmedinac.com/" />
    <meta property="og:image" content="https://jesusdmedinac.com/images/zora-cards.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Senior Android & KMP Architect | Jesús Medina (PST)" />
    <meta name="twitter:description" content="Senior Android and KMP contract engineering ($35-$55/h), architecture audits, and native migrations in Pacific Time." />
    <meta name="twitter:image" content="https://jesusdmedinac.com/images/zora-cards.png" />
    <Analytics />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://jesusdmedinac.com/#person",
            "name": "Jesús Daniel Medina Cruz",
            "jobTitle": "Senior Mobile Platform Architect & Android / KMP Contractor",
            "url": "https://jesusdmedinac.com",
            "sameAs": [
              "https://linkedin.com/in/jesusdmedinac",
              "https://github.com/jesusdmedinac"
            ],
            "knowsAbout": [
              "Android Development",
              "Kotlin",
              "Jetpack Compose",
              "Kotlin Multiplatform (KMP)",
              "Compose Multiplatform",
              "SwiftUI",
              "React Native",
              "AI Agents",
              "Model Context Protocol (MCP)",
              "Clean Architecture",
              "Test-Driven Development (TDD)",
              "Server-Driven UI"
            ]
          },
          {
            "@type": "ProfessionalService",
            "@id": "https://jesusdmedinac.com/#service",
            "name": "Jesús Daniel Medina Cruz - Mobile Platform Architecture & Consulting",
            "url": "https://jesusdmedinac.com",
            "image": "https://jesusdmedinac.com/images/zora-cards.png",
            "priceRange": "$$",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Tijuana",
              "addressRegion": "BC",
              "addressCountry": "MX"
            },
            "provider": {
              "@id": "https://jesusdmedinac.com/#person"
            },
            "description": "Senior mobile platform engineering and Kotlin Multiplatform (KMP) architecture for startups and scale-ups (11 years of experience). Specializing in Android SDK, Jetpack Compose, KMP, React Native, and AI-native mobile delivery in Pacific Time (PST).",
            "areaServed": [
              {
                "@type": "Country",
                "name": "United States"
              },
              {
                "@type": "Country",
                "name": "Mexico"
              }
            ],
            "audience": {
              "@type": "Audience",
              "audienceType": "Tech Startups, CTOs, VPs of Engineering, and Mobile Engineering Leaders"
            },
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Mobile Engineering & Architecture Services",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "name": "Senior Android / KMP Contractor & Fractional Architect",
                  "description": "20 to 40 hours per week of dedicated mobile engineering, architecture, code reviews, and PR delivery in Pacific Timezone (PST), available January 4 via US Form W-8BEN or California TN.",
                  "price": "35",
                  "priceCurrency": "USD",
                  "availability": "https://schema.org/InStock",
                  "url": "https://jesusdmedinac.com/#consulting",
                  "priceSpecification": {
                    "@type": "UnitPriceSpecification",
                    "price": "35-55",
                    "priceCurrency": "USD",
                    "unitText": "HOUR"
                  }
                },
                {
                  "@type": "Offer",
                  "name": "5-Day Mobile Architecture & Performance Audit",
                  "description": "Fixed-scope technical teardown of crash logs, memory consumption, CI/CD bottlenecks, and modularization with executive roadmap.",
                  "price": "3000",
                  "priceCurrency": "USD",
                  "availability": "https://schema.org/InStock",
                  "url": "https://jesusdmedinac.com/#consulting",
                  "priceSpecification": {
                    "@type": "UnitPriceSpecification",
                    "price": "2500-3500",
                    "priceCurrency": "USD"
                  }
                },
                {
                  "@type": "Offer",
                  "name": "2-Week Core Pilot Sprint",
                  "description": "Rapid end-to-end delivery of an initial core feature, SDK integration, or shared logic engine using KMP or React Native.",
                  "price": "3500",
                  "priceCurrency": "USD",
                  "availability": "https://schema.org/InStock",
                  "url": "https://jesusdmedinac.com/#consulting",
                  "priceSpecification": {
                    "@type": "UnitPriceSpecification",
                    "price": "3500-5000",
                    "priceCurrency": "USD"
                  }
                }
              ]
            }
          }
        ]
      }
    </script>
  </head>
  <body>
    <AmbientShaderCanvas />

    <main class="page-main">
      <!-- Machine Readable Semantic Knowledge Block (Invisible to humans, readable by AI crawlers & scrapers) -->
      <section
        class="sr-only"
        aria-label="Machine-Readable Product and Service Knowledge"
        style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;"
      >
        <h2>Jesús Daniel Medina Cruz | Senior Mobile Platform Architect & Android / KMP Contractor</h2>
        <p>
          Senior mobile engineering and architectural leadership (11 years of experience) for startups and enterprise teams. Specializing in Android Native, Kotlin Multiplatform (KMP), React Native, and AI-native mobile engineering in Pacific Time (PST).
        </p>
        <h3>Core Technical Capabilities</h3>
        <ul>
          <li>Native Android Craft: Kotlin, Jetpack Compose, Android SDK internals, Coroutines/StateFlow, Clean Architecture, and Unidirectional Data Flow (UDF).</li>
          <li>Kotlin Multiplatform (KMP) & iOS Interop: Shared domain logic, networking, and SQLDelight/Room persistence with native Jetpack Compose and SwiftUI interfaces via Touchlab SKIE and SPM.</li>
          <li>Cross-Platform & Hybrid: React Native (TypeScript, custom native Android modules) for 0-to-1 delivery and native migrations.</li>
          <li>AI-Native Mobile Engineering: Daily production delivery with AI coding agents (Claude Code), spec-driven planning, TDD, and CI guardrails; creator of json-to-compose (Maven Central), kmp-cli (CLI + MCP server and Agent Skills), and Zora Community (Android, iOS, Desktop).</li>
          <li>Enterprise Scale & Offline-First Resilience: Wells Fargo (Client Platform UI/navigation modernization for tens of millions of daily active users, 2025-01 to Present), Insulet (offline-first VIEW diabetes monitoring app with Room/SQLite, KMP CGM graph, 35% memory reduction), Bitso (CleverTap user engagement SDK via KMP), Beek.io (RN-to-native Android/iOS migration, KMP audio player, CircleCI/Fastlane CI/CD, 99.9% crash-free), Dexcom (JUnit 4/5 SDK testing).</li>
          <li>Clean Architecture & TDD: Decoupled Domain, Data, and Presentation layers with automated unit and UI test suites.</li>
        </ul>
        <h3>Target Ideal Customer Profile (ICP)</h3>
        <p>
          Roles: Chief Technology Officer (CTO), VP of Engineering, Head of Mobile, Technical Co-Founder.
          Companies: United States and LATAM tech companies (Seed to enterprise) seeking senior Android or KMP engineering horsepower in Pacific Time.
        </p>
        <h3>Commercial Engagement Models</h3>
        <ul>
          <li>Senior Android / KMP Contractor & Fractional Architect: $35 to $55 USD/hour (20-40 hrs/week), available January 4 from Tijuana, Mexico via US Form W-8BEN or California TN.</li>
          <li>5-Day Mobile Architecture & Performance Audit: $2,500 to $3,500 USD fixed scope.</li>
          <li>2-Week Core Pilot Sprint: $3,500 to $5,000 USD fixed scope.</li>
        </ul>
      </section>

      <AtmosphericHero />
      <SupportedPlatforms />
      <ProofOfWorkBento />
      <ConsultingCard />
      <MigrationServices />
      <ZoraProductShowcase />
      <ContactGrid />
    </main>

    <footer class="page-footer">
      <div class="footer-content">
        <p class="footer-copy">
          Remote-first Pacific Time (PST) from Tijuana, Mexico (W-8BEN), serving North America with San Diego / California on-site availability (TN).
        </p>
        <div class="footer-links">
          <a href="/display" class="tablet-kiosk-link">
            <span class="pulse-icon">●</span> Open Tablet Kiosk Display Mode
          </a>
        </div>
        <p class="footer-subcopy">
          &copy; {new Date().getFullYear()} Jesús Daniel Medina Cruz. All rights reserved.
        </p>
      </div>
    </footer>

    <style>
      .page-main {
        position: relative;
        z-index: 1;
        width: 100%;
      }

      .page-footer {
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--border-subtle);
        background: rgba(9, 9, 11, 0.85);
        backdrop-filter: blur(12px);
        padding: 3rem 1.5rem;
        text-align: center;
      }

      .footer-content {
        max-width: 640px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
      }

      .footer-copy {
        font-size: 0.95rem;
        color: var(--text-secondary);
      }

      .footer-links {
        margin: 0.5rem 0;
      }

      .tablet-kiosk-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--brand-kmp);
        background: rgba(127, 82, 255, 0.1);
        border: 1px solid rgba(127, 82, 255, 0.25);
        padding: 8px 16px;
        border-radius: 9999px;
        transition: all 0.2s ease;
      }

      .tablet-kiosk-link:hover {
        background: rgba(127, 82, 255, 0.2);
        color: #ffffff;
        transform: translateY(-1px);
      }

      .pulse-icon {
        color: var(--brand-android);
        animation: pulseDot 2s infinite ease-in-out;
      }

      .footer-subcopy {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
    </style>
  </body>
</html>
